@page "{id}"
@model CreateSpecializedBookingModel
@{
	ViewData["Title"] = "Book Specialized Room";
	var minDate = DateTime.Today.ToString("yyyy-MM-dd");
	var maxDate = DateTime.Today.AddDays(60).ToString("yyyy-MM-dd");
	var defaultDate = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="container mt-4">
	<h2>Book Specialized Room</h2>

	@if (Model.Room != null)
	{
		<div class="card">
			<div class="card-header">
				<h4>@Model.Room.Name - @Model.Room.Code</h4>
			</div>
			<div class="card-body">
				<div class="row mb-4">
					<div class="col-md-6">
						<p><strong>Location:</strong> @Model.Room.Location</p>
						<p><strong>Capacity:</strong> @Model.Room.Capacity persons</p>
					</div>
					<div class="col-md-6">
						<p><strong>Type:</strong> @Model.Room.Type</p>
						<p><strong>Description:</strong> @Model.Room.Description</p>
					</div>
				</div>

				<form method="post">
					<input type="hidden" name="roomId" value="@Model.Room.Id" />

					<div class="row">
						<div class="col-md-6">
							<div class="form-group">
								<label for="bookingDate" class="form-label">Booking Date *</label>
								<input type="date" id="bookingDate" name="bookingDate" 
									   min="@minDate" max="@maxDate"
									   value="@defaultDate" class="form-control" required />
								<small class="text-muted">You can book from today up to 60 days in advance</small>
							</div>
						</div>
					</div>

					<div class="row">
						<div class="col-md-3">
							<div class="form-group">
								<label for="startTime" class="form-label">Start Time *</label>
								<input type="time" id="startTime" name="startTime" 
									   value="08:00" class="form-control" required />
							</div>
						</div>
						<div class="col-md-3">
							<div class="form-group">
								<label for="endTime" class="form-label">End Time *</label>
								<input type="time" id="endTime" name="endTime" 
									   value="17:00" class="form-control" required />
							</div>
						</div>
					</div>

					<div class="form-group">
						<label for="notes" class="form-label">Notes / Special Requests</label>
						<textarea id="notes" name="notes" class="form-control" rows="3"></textarea>
					</div>

					<div class="mt-4">
						<button type="submit" class="btn btn-primary">Book This Room</button>
						<a asp-page="SearchSpecialized" class="btn btn-secondary">Back to Search</a>
					</div>
				</form>
			</div>
		</div>
	}
	else
	{
		<div class="alert alert-danger">Room not found.</div>
		<a asp-page="SearchSpecialized" class="btn btn-secondary">Back to Search</a>
	}
</div>
