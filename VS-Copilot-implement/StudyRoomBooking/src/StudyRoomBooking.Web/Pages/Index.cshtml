@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8">
            <h1>Study Room Booking System</h1>
            <p class="lead">Welcome to the Study Room Booking and Management System!</p>

            @if (Model.IsAuthenticated)
            {
                <p>You are logged in as: <strong>@Model.UserName</strong> (@Model.UserRole)</p>

                <div class="row mt-4">
                    <div class="col-md-6">
                        <div class="card mb-3">
                            <div class="card-body">
                                <h5 class="card-title">Search Rooms</h5>
                                <p class="card-text">Find and search available study rooms</p>
                                <a href="/Search/Index" class="btn btn-primary">Search Rooms</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card mb-3">
                            <div class="card-body">
                                <h5 class="card-title">My Bookings</h5>
                                <p class="card-text">View and manage your bookings</p>
                                <a href="/Bookings/Index" class="btn btn-primary">My Bookings</a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="card mb-3">
                            <div class="card-body">
                                <h5 class="card-title">Booking History</h5>
                                <p class="card-text">View your booking history</p>
                                <a href="/BookingHistory/Index" class="btn btn-primary">History</a>
                            </div>
                        </div>
                    </div>

                    @if (Model.UserRole == "Admin")
                    {
                        <div class="col-md-6">
                            <div class="card mb-3">
                                <div class="card-body">
                                    <h5 class="card-title">Administration</h5>
                                    <p class="card-text">Manage rooms and users</p>
                                    <a href="/Admin/Dashboard" class="btn btn-danger">Admin Panel</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
