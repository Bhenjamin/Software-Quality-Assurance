<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Study Room Booking System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StudyRoomBooking.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Study Room Booking</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        @{
                            var userRole = Context.Session.GetString("CurrentUserRole") ?? "";
                        }
                        @if (userRole == "Student")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Students/Search">Search Room</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Students/MyBookings">My Bookings</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Students/BookingHistory">Booking History</a>
                            </li>
                        }
                        @if (userRole == "Staff")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Staff/SearchSpecialized">Specialized Rooms</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Staff/CreateRecurring">Recurring Bookings</a>
                            </li>
                        }
                        @if (userRole == "Admin")
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="adminMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Admin
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="adminMenu">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/RoomManagement">Rooms</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/BookingManagement">Bookings</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/UserRoles">User Roles</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/AccessRules">Access Rules</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Overrides">Overrides</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Reports">Reports</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="languageMenu" data-bs-toggle="dropdown" aria-expanded="false">
                            Language
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="languageMenu">
                            <li><a class="dropdown-item" href="?lang=en">English</a></li>
                            <li><a class="dropdown-item" href="?lang=vi">Tiếng Việt</a></li>
                        </ul>
                    </div>
                    <div class="ms-2">
                        @if (Context.Session.GetString("CurrentUser") != null)
                        {
                            <a asp-page="/Logout" class="btn btn-sm btn-outline-danger">Logout</a>
                        }
                    </div>

            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Study Room Booking System
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
