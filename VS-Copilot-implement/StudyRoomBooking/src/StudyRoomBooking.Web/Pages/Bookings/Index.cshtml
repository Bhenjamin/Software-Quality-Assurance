@page
@model StudyRoomBooking.Web.Pages.Bookings.IndexModel
@{
	ViewData["Title"] = "My Bookings";
}

<div class="container mt-4">
	<div class="row mb-3">
		<div class="col-md-8">
			<h1>My Bookings</h1>
		</div>
		<div class="col-md-4 text-end">
			<a href="/Search/Index" class="btn btn-primary">+ New Booking</a>
		</div>
	</div>

	@if (Model.Bookings.Count == 0)
	{
		<div class="alert alert-info">You have no active bookings.</div>
	}
	else
	{
		<table class="table table-striped">
			<thead>
				<tr>
					<th>Room</th>
					<th>Date</th>
					<th>Time</th>
					<th>Status</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var booking in Model.Bookings)
				{
					<tr>
						<td>@booking.RoomName</td>
						<td>@booking.BookingDate.ToString("MMM dd, yyyy")</td>
						<td>@booking.StartTime.ToString("hh\\:mm") - @booking.EndTime.ToString("hh\\:mm")</td>
						<td>
							@if (booking.Status.ToString() == "Confirmed")
							{
								<span class="badge bg-success">Confirmed</span>
							}
							else if (booking.Status.ToString() == "Cancelled")
							{
								<span class="badge bg-danger">Cancelled</span>
							}
							else
							{
								<span class="badge bg-warning">Pending</span>
							}
						</td>
						<td>
							<a href="/Bookings/Edit?id=@booking.Id" class="btn btn-sm btn-warning">Edit</a>
							<a href="/Bookings/Cancel/@booking.Id" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?');">Cancel</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
</div>
