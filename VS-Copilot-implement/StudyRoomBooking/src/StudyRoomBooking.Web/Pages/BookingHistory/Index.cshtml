@page
@model StudyRoomBooking.Web.Pages.BookingHistory.IndexModel
@{
	ViewData["Title"] = "Booking History";
}

<div class="container mt-4">
	<h1>Booking History</h1>

	@if (Model.BookingHistory.Count == 0)
	{
		<div class="alert alert-info mt-4">You have no bookings in history.</div>
	}
	else
	{
		<table class="table table-striped mt-4">
			<thead>
				<tr>
					<th>Room</th>
					<th>Date</th>
					<th>Time</th>
					<th>Status</th>
					<th>Notes</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var booking in Model.BookingHistory)
				{
					<tr>
						<td>@booking.RoomName</td>
						<td>@booking.BookingDate.ToString("MMM dd, yyyy")</td>
						<td>@booking.StartTime.ToString("hh\\:mm") - @booking.EndTime.ToString("hh\\:mm")</td>
						<td>
							@if (booking.Status.ToString() == "Confirmed")
							{
								<span class="badge bg-success">Confirmed</span>
							}
							else if (booking.Status.ToString() == "Cancelled")
							{
								<span class="badge bg-danger">Cancelled</span>
							}
							else
							{
								<span class="badge bg-warning">Pending</span>
							}
						</td>
						<td>@booking.Notes</td>
					</tr>
				}
			</tbody>
		</table>
	}
</div>
