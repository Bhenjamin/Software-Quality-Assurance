@page
@model StudyRoomBooking.Web.Pages.Admin.DashboardModel
@{
	ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid mt-4">
	<h1>Administration Dashboard</h1>

	<div class="row mt-4">
		<div class="col-md-3">
			<div class="card bg-primary text-white">
				<div class="card-body">
					<h5 class="card-title">Total Users</h5>
					<h1>@Model.Users.Count</h1>
					<a href="/Admin/Users" class="btn btn-light btn-sm">Manage Users</a>
				</div>
			</div>
		</div>
		<div class="col-md-3">
			<div class="card bg-info text-white">
				<div class="card-body">
					<h5 class="card-title">Total Rooms</h5>
					<h1>@Model.Rooms.Count</h1>
					<a href="/Rooms/Index" class="btn btn-light btn-sm">Manage Rooms</a>
				</div>
			</div>
		</div>
		<div class="col-md-3">
			<div class="card bg-success text-white">
				<div class="card-body">
					<h5 class="card-title">Total Bookings</h5>
					<h1>@Model.Bookings.Count</h1>
				</div>
			</div>
		</div>
		<div class="col-md-3">
			<div class="card bg-warning text-white">
				<div class="card-body">
					<h5 class="card-title">Quick Links</h5>
					<a href="/Admin/AccessRules" class="btn btn-light btn-sm">Access Rules</a>
					<a href="/Admin/Reports" class="btn btn-light btn-sm">Reports</a>
				</div>
			</div>
		</div>
	</div>

	<div class="row mt-4">
		<div class="col-md-6">
			<h3>Recent Bookings</h3>
			@if (Model.Bookings.Count == 0)
			{
				<p>No bookings</p>
			}
			else
			{
				<table class="table table-sm">
					<thead>
						<tr>
							<th>Room</th>
							<th>Date</th>
							<th>Status</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var booking in Model.Bookings.Take(5))
						{
							<tr>
								<td>@booking.RoomName</td>
								<td>@booking.BookingDate.ToString("MMM dd")</td>
								<td>@booking.Status</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>

		<div class="col-md-6">
			<h3>Users</h3>
			@if (Model.Users.Count == 0)
			{
				<p>No users</p>
			}
			else
			{
				<table class="table table-sm">
					<thead>
						<tr>
							<th>Email</th>
							<th>Role</th>
							<th>Active</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var user in Model.Users.Take(5))
						{
							<tr>
								<td>@user.Email</td>
								<td>@user.Role</td>
								<td>@(user.IsActive ? "Yes" : "No")</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>
	</div>
</div>
