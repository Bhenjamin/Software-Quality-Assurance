@page
@model StudyRoomBooking.Web.Pages.Rooms.IndexModel
@{
	ViewData["Title"] = "Manage Rooms";
}

<div class="container mt-4">
	<div class="row mb-3">
		<div class="col-md-8">
			<h1>Manage Rooms</h1>
		</div>
		<div class="col-md-4 text-end">
			<a href="/Rooms/Create" class="btn btn-success">+ Create Room</a>
		</div>
	</div>

	@if (Model.Rooms.Count == 0)
	{
		<div class="alert alert-info">No rooms found.</div>
	}
	else
	{
		<table class="table table-striped">
			<thead>
				<tr>
					<th>Code</th>
					<th>Name</th>
					<th>Location</th>
					<th>Capacity</th>
					<th>Type</th>
					<th>Available</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var room in Model.Rooms)
				{
					<tr>
						<td>@room.RoomCode</td>
						<td>@room.RoomName</td>
						<td>@room.Location</td>
						<td>@room.Capacity</td>
						<td>@room.RoomType</td>
						<td>
							@if (room.IsAvailable)
							{
								<span class="badge bg-success">Yes</span>
							}
							else
							{
								<span class="badge bg-danger">No</span>
							}
						</td>
						<td>
							<a href="/Rooms/Edit?id=@room.Id" class="btn btn-sm btn-warning">Edit</a>
							<a href="/Rooms/Delete?id=@room.Id" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?');">Delete</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
</div>
