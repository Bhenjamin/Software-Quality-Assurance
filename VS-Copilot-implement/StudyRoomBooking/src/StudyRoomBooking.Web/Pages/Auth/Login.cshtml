@page
@model StudyRoomBooking.Web.Pages.Auth.LoginModel
@{
	ViewData["Title"] = "Login";
}

<div class="container mt-5">
	<div class="row justify-content-center">
		<div class="col-md-6">
			<div class="card">
				<div class="card-header">
					<h2>Login</h2>
				</div>
				<div class="card-body">
					@if (!string.IsNullOrEmpty(Model.ErrorMessage))
					{
						<div class="alert alert-danger">@Model.ErrorMessage</div>
					}

					<form method="post">
						<div class="mb-3">
							<label for="email" class="form-label">Email</label>
							<input type="email" class="form-control" id="email" asp-for="LoginInput.Email" required>
							<span class="text-danger" asp-validation-for="LoginInput.Email"></span>
						</div>

						<div class="mb-3">
							<label for="password" class="form-label">Password</label>
							<input type="password" class="form-control" id="password" asp-for="LoginInput.Password" required>
							<span class="text-danger" asp-validation-for="LoginInput.Password"></span>
						</div>

						<button type="submit" class="btn btn-primary w-100">Sign In</button>
					</form>

					<hr />

					<p class="text-center">
						<small>
							Demo Credentials:<br />
							Student: student1@university.edu / student123<br />
							Staff: staff1@university.edu / staff123<br />
							Admin: admin@university.edu / admin123
						</small>
					</p>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
