@page
@model StudyRoomBooking.Web.Pages.Rooms.SearchModel
@{
    ViewData["Title"] = "Search Rooms";
}

<h1>Find a room</h1>

<form method="get" class="row g-3 mb-4">
    <div class="col-md-3">
        <label class="form-label">Min capacity</label>
        <input type="number" name="MinCapacity" value="@Model.MinCapacity" class="form-control" min="1" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Location contains</label>
        <input type="text" name="Location" value="@Model.Location" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Room type</label>
        <select name="Type" class="form-select">
            <option value="">Any</option>
            @foreach (var type in Enum.GetValues<RoomType>())
            {
                <option value="@type" selected="@(Model.Type == type)">@type</option>
            }
        </select>
    </div>
    <div class="col-md-3 align-self-end">
        <button type="submit" class="btn btn-primary w-100">Filter</button>
    </div>
</form>

<h2 class="h5">@Model.Results.Count room(s)</h2>
<p class="text-muted">Pick a room to see its availability calendar for the month.</p>

<table class="table table-striped">
    <thead>
        <tr><th>Room</th><th>Location</th><th>Capacity</th><th>Type</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var room in Model.Results)
        {
            <tr>
                <td>
                    @room.Name
                    @if (room.RequiresRestrictedAccess)
                    {
                        <span class="badge bg-secondary ms-1">Restricted access</span>
                    }
                </td>
                <td>@room.Location</td>
                <td>@room.Capacity</td>
                <td>@room.Type</td>
                <td>
                    <a class="btn btn-sm btn-success" href="/Rooms/Calendar?roomId=@room.Id">View availability</a>
                </td>
            </tr>
        }
    </tbody>
</table>
