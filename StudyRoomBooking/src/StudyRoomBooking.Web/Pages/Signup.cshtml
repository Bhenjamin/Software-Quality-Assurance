					<p>These terms and conditions are governed by and construed in accordance with the laws of the jurisdiction, and you irrevocably submit to the exclusive jurisdiction of the courts in that location.</p>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
				</div>
			</div>
		</div>
	</div>

	<!-- Custom Language Selector -->
	<script>
		document.addEventListener("DOMContentLoaded", function() {
			const selector = document.getElementById("languageSelector");

			if (!selector) {
				return;
			}

			// Read the current Google Translate cookie
			function getGoogleLanguage() {
				const cookies = document.cookie.split("; ");
				const cookie = cookies.find(function(row) {
					return row.startsWith("googtrans=");
				});

				if (!cookie) {
					return "en";
				}

				const value = decodeURIComponent(
					cookie.substring("googtrans=".length)
				);

				return value.split("/")[2] || "en";
			}

			// Set initial language
			selector.value = getGoogleLanguage();

			// Listen for changes
			selector.addEventListener("change", function() {
				const lang = this.value;
				if (lang === "en") {
					// Clear Google Translate cookie when selecting English
					document.cookie = "googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
					location.href = location.protocol + "//" + location.host + location.pathname;
				} else {
					// Trigger Google Translate to change language
					const selectElement = document.querySelector('.goog-te-combo');
					if (selectElement) {
						selectElement.value = lang;
						selectElement.dispatchEvent(new Event('change'));
					}
				}
			});
		});
	</script>
</body>
</html>

