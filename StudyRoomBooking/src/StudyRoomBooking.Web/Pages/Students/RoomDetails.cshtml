@page "{id}"
@model RoomDetailsModel
@{
	ViewData["Title"] = "Room Details";
	var minDate = DateTime.Today.ToString("yyyy-MM-dd");
	var maxDate = DateTime.Today.AddDays(60).ToString("yyyy-MM-dd");
	var defaultDate = DateTime.Today.ToString("yyyy-MM-dd");
}

<style>
	.time-validation-error {
		display: none;
		color: #dc3545;
		font-size: 0.875rem;
		margin-top: 0.25rem;
	}
	.time-validation-error.show {
		display: block;
	}
</style>

<div class="container mt-4">
	<div class="row">
		<div class="col-md-12">
			@if (Model.Room != null)
			{
				<div class="card mb-4">
					<div class="card-header">
						<h3>@Model.Room.Name</h3>
					</div>
					<div class="card-body">
						<div class="row mb-3">
							<div class="col-md-6">
								<p><strong>Room Code:</strong> @Model.Room.Code</p>
								<p><strong>Location:</strong> @Model.Room.Location</p>
								<p><strong>Capacity:</strong> @Model.Room.Capacity persons</p>
							</div>
							<div class="col-md-6">
								<p><strong>Type:</strong> @Model.Room.Type.ToDisplayName()</p>
								<p><strong>Status:</strong> 
									@if (Model.Room.IsAvailable)
									{
										<span class="badge bg-success">Available</span>
									}
									else
									{
										<span class="badge bg-danger">Not Available</span>
									}
								</p>
							</div>
						</div>
						<p><strong>Description:</strong> @Model.Room.Description</p>

						@if (Model.Room.IsAvailable)
						{
							@if (!ViewData.ModelState.IsValid)
							{
								<div class="alert alert-danger alert-dismissible fade show" role="alert">
									<strong>Booking Unavailable</strong>
									<div class="mb-0" style="white-space: pre-line;">
										@foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
										{
											<div>@error.ErrorMessage</div>
										}
									</div>
									<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
								</div>
							}

							<form method="post">
								<input type="hidden" name="roomId" value="@Model.Room.Id" />

								<div class="row mt-4">
									<div class="col-md-6">
										<div class="form-group">
											<label for="bookingDate" class="form-label">Date *</label>
											<div class="input-group">
												<button type="button" id="bookingDateBackBtn" class="btn btn-outline-secondary" title="Previous day">
													<i class="bi bi-chevron-down"></i> ◀
												</button>
												<input type="date" id="bookingDate" name="bookingDate" 
													   min="@minDate" max="@maxDate"
													   value="@(Model.SubmittedBookingDate ?? Model.DefaultBookingDate)" class="form-control" required />
												<button type="button" id="bookingDateForwardBtn" class="btn btn-outline-secondary" title="Next day">
													▶ <i class="bi bi-chevron-up"></i>
												</button>
											</div>
											<small class="text-muted">Today to 60 days ahead</small>
											<div id="bookingDateWarning" class="alert alert-warning mt-2" style="display: none; padding: 0.5rem 0.75rem; margin: 0.5rem 0;">
												Cannot go to past date. Today is selected.
											</div>
										</div>
									</div>
								</div>

								<div class="row">
									<div class="col-md-3">
										<div class="form-group">
											<label for="startTime" class="form-label">Start Hour *</label>
											<select id="startTime" name="startTime" class="form-select" required>
												@for (int hour = 8; hour <= 21; hour++)
												{
													var timeValue = $"{hour}:00";
													var isSelected = (Model.SubmittedStartTime == timeValue) || 
																(Model.SubmittedStartTime == null && Model.DefaultStartTime == timeValue) || 
																(Model.SubmittedStartTime == null && Model.DefaultStartTime == null && hour == 8);
													<option value="@timeValue" selected="@isSelected">@hour:00</option>
												}
											</select>
										</div>
										</div>
										<div class="col-md-3">
											<div class="form-group">
												<label for="endTime" class="form-label">End Hour *</label>
												<select id="endTime" name="endTime" class="form-select" required>
													@for (int hour = 9; hour <= 22; hour++)
													{
														var timeValue = $"{hour}:00";
														var isSelected = (Model.SubmittedEndTime == timeValue) || 
																		(Model.SubmittedEndTime == null && Model.DefaultEndTime == timeValue) || 
																		(Model.SubmittedEndTime == null && Model.DefaultEndTime == null && hour == 17);
														<option value="@timeValue" selected="@isSelected">@hour:00</option>
													}
												</select>
												<div id="timeValidationError" class="time-validation-error">Start hour must be before end hour.</div>
											</div>
										</div>
									</div>

								<div class="form-group mt-3">
									<label for="notes" class="form-label">Notes (optional)</label>
									<textarea id="notes" name="notes" class="form-control" rows="3"></textarea>
								</div>

								<div class="booking-actions mt-3">
									<button type="submit" class="btn btn-primary" asp-page-handler="BookRoom">Book this room</button>
									<a asp-page="/Index" class="btn btn-secondary">Back</a>
								</div>
							</form>
						}
						else
						{
							<div class="alert alert-danger mt-3">This room is currently not available.</div>
							<a asp-page="/Index" class="btn btn-secondary">Back</a>
						}
					</div>
				</div>
			}
			else
			{
				<div class="alert alert-danger">Room not found.</div>
			}
		</div>

	</div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
	const startTimeSelect = document.getElementById('startTime');
	const endTimeSelect = document.getElementById('endTime');
	const bookButton = document.querySelector('button[asp-page-handler="BookRoom"]');
	const timeValidationError = document.getElementById('timeValidationError');

	function validateTimeRange() {
		if (startTimeSelect.value && endTimeSelect.value) {
			const startHour = parseInt(startTimeSelect.value.split(':')[0]);
			const endHour = parseInt(endTimeSelect.value.split(':')[0]);

			if (startHour >= endHour) {
				timeValidationError.classList.add('show');
				if (bookButton) bookButton.disabled = true;
				return false;
			} else {
				timeValidationError.classList.remove('show');
				if (bookButton) bookButton.disabled = false;
				return true;
			}
		} else {
			timeValidationError.classList.remove('show');
			if (bookButton) bookButton.disabled = false;
			return true;
		}
	}

	// Add event listeners to both time selects
	startTimeSelect.addEventListener('change', validateTimeRange);
	endTimeSelect.addEventListener('change', validateTimeRange);

	// Date navigation buttons for Booking Date
	const bookingDateInput = document.getElementById('bookingDate');
	const bookingDateBackBtn = document.getElementById('bookingDateBackBtn');
	const bookingDateForwardBtn = document.getElementById('bookingDateForwardBtn');
	const bookingDateWarning = document.getElementById('bookingDateWarning');

	function updateDateButtons() {
		const currentDate = bookingDateInput.value;
		const minDate = bookingDateInput.getAttribute('min');
		const maxDate = bookingDateInput.getAttribute('max');

		// Use proper date comparison instead of string comparison
		const currentDateObj = new Date(currentDate);
		const minDateObj = new Date(minDate);
		const maxDateObj = new Date(maxDate);

		bookingDateBackBtn.disabled = currentDateObj <= minDateObj;
		bookingDateForwardBtn.disabled = currentDateObj >= maxDateObj;
	}

	bookingDateBackBtn.addEventListener('click', function(e) {
		e.preventDefault();
		const currentDate = new Date(bookingDateInput.value);
		const previousDate = new Date(currentDate);
		previousDate.setDate(previousDate.getDate() - 1);
		const previousDateStr = previousDate.toISOString().split('T')[0];
		const minDate = bookingDateInput.getAttribute('min');

		if (previousDateStr < minDate) {
			bookingDateWarning.textContent = 'Cannot go to past date. ' + new Date(minDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) + ' is selected.';
			bookingDateWarning.style.display = 'block';
			setTimeout(() => { bookingDateWarning.style.display = 'none'; }, 3000);
		} else {
			bookingDateInput.value = previousDateStr;
			bookingDateWarning.style.display = 'none';
			updateDateButtons();
		}
	});

	bookingDateForwardBtn.addEventListener('click', function(e) {
		e.preventDefault();
		const currentDate = new Date(bookingDateInput.value);
		const nextDate = new Date(currentDate);
		nextDate.setDate(nextDate.getDate() + 1);
		const nextDateStr = nextDate.toISOString().split('T')[0];
		const maxDate = bookingDateInput.getAttribute('max');
		if (nextDateStr > maxDate) return;
		bookingDateInput.value = nextDateStr;
		bookingDateWarning.style.display = 'none';
		updateDateButtons();
	});

	// Update button states when date input changes (calendar selection)
	bookingDateInput.addEventListener('change', function() {
		updateDateButtons();
	});

	updateDateButtons();

	// Validate on form submission
	const form = document.querySelector('form');
	if (form) {
		form.addEventListener('submit', function(e) {
			if (!validateTimeRange()) {
				e.preventDefault();
			}
		});
	}

	// Initial validation in case values are pre-filled
	validateTimeRange();
});
</script>
