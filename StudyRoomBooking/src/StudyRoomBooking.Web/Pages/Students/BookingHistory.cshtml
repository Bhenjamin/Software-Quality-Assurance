@page
@model BookingHistoryModel
@{
	ViewData["Title"] = "Booking History";
}

<div class="container mt-4">
	@* <h2>Booking History</h2> *@

	@if (!string.IsNullOrEmpty(Model.Message))
	{
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			@Model.Message
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	<h3 class="mt-4">Current Bookings</h3>
	@if (Model.Bookings.Any())
	{
		<div class="table-responsive">
			<table class="table table-striped">
				<thead>
					<tr>
						<th>Room Name</th>
						<th>Date</th>
						<th>Time</th>
						<th>Status</th>
						<th>Confirmation Number</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var booking in Model.Bookings)
					{
						<tr>
							<td>@booking.RoomName</td>
							<td>@booking.BookingDate.ToString("dd/MM/yyyy")</td>
							<td>@booking.StartTime.ToString(@"hh\:mm") - @booking.EndTime.ToString(@"hh\:mm")</td>
							<td>
								@if (booking.Status == StudyRoomBooking.Domain.Enums.BookingStatus.Confirmed)
								{
									<span class="badge bg-success">Confirmed</span>
								}
								else if (booking.Status == StudyRoomBooking.Domain.Enums.BookingStatus.Expired)
								{
									<span class="badge bg-secondary">Expired</span>
								}
								else if (booking.Status == StudyRoomBooking.Domain.Enums.BookingStatus.Cancelled)
								{
									<span class="badge bg-danger">Cancelled</span>
								}
								else
								{
									<span class="badge bg-warning">@booking.Status</span>
								}
							</td>
							<td>@booking.ConfirmationNumber</td>
							<td>
								@if (booking.Status == StudyRoomBooking.Domain.Enums.BookingStatus.Confirmed)
								{
									<a asp-page="ModifyBooking" asp-route-id="@booking.Id" class="btn btn-sm btn-warning">Edit</a>
								}
								<form method="post" class="d-inline">
									<button type="submit" class="btn btn-sm btn-danger" asp-page-handler="CancelBooking" asp-route-id="@booking.Id" onclick="return confirm('Are you sure?');">Cancel</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
	else
	{
		<div class="alert alert-info">You don't have any current bookings. <a asp-page="/Index">Book a room</a></div>
	}

	<h3 class="mt-5">Previous Bookings</h3>
	@if (Model.PreviousBookings.Any())
	{
		<div class="table-responsive">
			<table class="table table-striped">
				<thead>
					<tr>
						<th>Room Name</th>
						<th>Date</th>
						<th>Time</th>
						<th>Status</th>
						<th>Confirmation Number</th>
						<th>Created</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var booking in Model.PreviousBookings)
					{
						<tr>
							<td>@booking.RoomName</td>
							<td>@booking.BookingDate.ToString("dd/MM/yyyy")</td>
							<td>@booking.StartTime.ToString(@"hh\:mm") - @booking.EndTime.ToString(@"hh\:mm")</td>
							<td>
								@if (booking.Status == StudyRoomBooking.Domain.Enums.BookingStatus.Cancelled)
								{
									<span class="badge bg-danger">Cancelled</span>
								}
								else if (booking.Status == StudyRoomBooking.Domain.Enums.BookingStatus.Expired)
								{
									<span class="badge bg-secondary">Expired</span>
								}
								else if (booking.Status == StudyRoomBooking.Domain.Enums.BookingStatus.Completed)
								{
									<span class="badge bg-info">Completed</span>
								}
								else
								{
									<span class="badge bg-warning">@booking.Status</span>
								}
							</td>
							<td>@booking.ConfirmationNumber</td>
							<td>@booking.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
	else
	{
		<div class="alert alert-info">No previous bookings found.</div>
	}

	<div class="mt-3">
		<a asp-page="/Index" class="btn btn-primary">Book a Room</a>
	</div>
</div>
