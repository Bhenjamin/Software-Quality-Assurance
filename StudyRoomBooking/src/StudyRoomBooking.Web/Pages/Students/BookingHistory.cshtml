@page
@model BookingHistoryModel
@{
	ViewData["Title"] = "Booking History";
}

<style>
	.cancel-booking-modal .modal-content {
		border: none;
		border-radius: 10px;
		box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
	}
	.cancel-booking-modal .modal-header {
		background: #1E3A5F;
		color: white;
		border-bottom: 2px solid #e9ecef;
		border-radius: 10px 10px 0 0;
	}
	.cancel-booking-modal .modal-footer {
		border-top: 2px solid #e9ecef;
		background-color: #f8f9fa;
		border-radius: 0 0 10px 10px;
	}
</style>

<div class="container mt-4">
	@* <h2>Booking History</h2> *@

	@if (!string.IsNullOrEmpty(Model.Message))
	{
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			@Model.Message
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	<h3 class="mt-4">Current Bookings</h3>
	@if (Model.Bookings.Any())
	{
		<div class="table-responsive">
			<table class="table table-striped">
				<thead>
					<tr>
						<th>Room Name</th>
						<th>Date</th>
						<th>Time</th>
						<th>Status</th>
						<th>Confirmation Number</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var booking in Model.Bookings)
					{
						<tr>
							<td>@booking.RoomName</td>
							<td>@booking.BookingDate.ToString("dd/MM/yyyy")</td>
							<td>@booking.StartTime.ToString(@"hh\:mm") - @booking.EndTime.ToString(@"hh\:mm")</td>
							<td>
								@if (booking.Status == StudyRoomBooking.Domain.Enums.BookingStatus.Confirmed)
								{
									<span class="badge bg-success">Confirmed</span>
								}
								else if (booking.Status == StudyRoomBooking.Domain.Enums.BookingStatus.Expired)
								{
									<span class="badge bg-secondary">Expired</span>
								}
								else if (booking.Status == StudyRoomBooking.Domain.Enums.BookingStatus.Cancelled)
								{
									<span class="badge bg-danger">Cancelled</span>
								}
								else
								{
									<span class="badge bg-warning">@booking.Status</span>
								}
							</td>
							<td>@booking.ConfirmationNumber</td>
							<td>
								@if (booking.Status == StudyRoomBooking.Domain.Enums.BookingStatus.Confirmed)
								{
									<a asp-page="ModifyBooking" asp-route-id="@booking.Id" class="btn btn-sm btn-warning">Edit</a>
								}
								<form method="post" class="d-inline">
									<button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#cancelBookingModal" data-booking-id="@booking.Id" data-room="@booking.RoomName" data-date="@booking.BookingDate.ToString("dd/MM/yyyy")" data-time="@booking.StartTime.ToString(@"hh\:mm") - @booking.EndTime.ToString(@"hh\:mm")" data-confirmation="@booking.ConfirmationNumber">Cancel</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
	else
	{
		<div class="alert alert-info">You don't have any current bookings. <a asp-page="/Index">Book a room</a></div>
	}

	<h3 class="mt-5">Previous Bookings</h3>
	@if (Model.PreviousBookings.Any())
	{
		<div class="table-responsive">
			<table class="table table-striped">
				<thead>
					<tr>
						<th>Room Name</th>
						<th>Date</th>
						<th>Time</th>
						<th>Status</th>
						<th>Confirmation Number</th>
						<th>Created</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var booking in Model.PreviousBookings)
					{
						<tr>
							<td>@booking.RoomName</td>
							<td>@booking.BookingDate.ToString("dd/MM/yyyy")</td>
							<td>@booking.StartTime.ToString(@"hh\:mm") - @booking.EndTime.ToString(@"hh\:mm")</td>
							<td>
								@if (booking.Status == StudyRoomBooking.Domain.Enums.BookingStatus.Cancelled)
								{
									<span class="badge bg-danger">Cancelled</span>
								}
								else if (booking.Status == StudyRoomBooking.Domain.Enums.BookingStatus.Expired)
								{
									<span class="badge bg-secondary">Expired</span>
								}
								else if (booking.Status == StudyRoomBooking.Domain.Enums.BookingStatus.Completed)
								{
									<span class="badge bg-info">Completed</span>
								}
								else
								{
									<span class="badge bg-warning">@booking.Status</span>
								}
							</td>
							<td>@booking.ConfirmationNumber</td>
							<td>@booking.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
	else
	{
		<div class="alert alert-info">No previous bookings found.</div>
	}

	<div class="mt-3">
		<a asp-page="/Index" class="btn btn-primary">Book a Room</a>
	</div>
</div>

<div class="modal fade cancel-booking-modal" id="cancelBookingModal" tabindex="-1" aria-labelledby="cancelBookingModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="cancelBookingModalLabel">Cancel Booking</h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<p>Are you sure you want to cancel this booking? Please review the details before confirming.</p>
				<dl class="row mb-0">
					<dt class="col-5">Room</dt>
					<dd class="col-7" id="cancelBookingRoom"></dd>
					<dt class="col-5">Date</dt>
					<dd class="col-7" id="cancelBookingDate"></dd>
					<dt class="col-5">Time</dt>
					<dd class="col-7" id="cancelBookingTime"></dd>
					<dt class="col-5">Confirmation</dt>
					<dd class="col-7" id="cancelBookingConfirmation"></dd>
				</dl>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Keep Booking</button>
				<form method="post" asp-page-handler="CancelBooking">
					<input type="hidden" name="id" id="cancelBookingId" />
					<button type="submit" class="btn btn-danger">Confirm Cancellation</button>
				</form>
			</div>
		</div>
	</div>
</div>

<script>
	document.getElementById('cancelBookingModal').addEventListener('show.bs.modal', function (event) {
		const trigger = event.relatedTarget;
		document.getElementById('cancelBookingId').value = trigger.dataset.bookingId;
		document.getElementById('cancelBookingRoom').textContent = trigger.dataset.room;
		document.getElementById('cancelBookingDate').textContent = trigger.dataset.date;
		document.getElementById('cancelBookingTime').textContent = trigger.dataset.time;
		document.getElementById('cancelBookingConfirmation').textContent = trigger.dataset.confirmation;
	});
</script>
