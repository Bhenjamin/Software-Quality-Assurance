@page
@model ReportsModel
@{
	ViewData["Title"] = "Reports";
}

<div class="container mt-4">
	<h2>System Reports</h2>

	<form method="post" class="card p-4 mb-4">
		<div class="row">
			<div class="col-md-3">
				<div class="form-group">
					<label for="startDate" class="form-label">Start Date</label>
					<input type="date" id="startDate" name="startDate" 
						   value="@Model.StartDate.ToString("yyyy-MM-dd")" class="form-control" />
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-group">
					<label for="endDate" class="form-label">End Date</label>
					<input type="date" id="endDate" name="endDate" 
						   value="@Model.EndDate.ToString("yyyy-MM-dd")" class="form-control" />
				</div>
			</div>
			<div class="col-md-6">
				<div class="form-group">
					<label>&nbsp;</label>
					<button type="submit" class="btn btn-primary form-control">Generate Report</button>
				</div>
			</div>
		</div>
	</form>

	@if (Model.BookingStatistics.Any())
	{
		<div class="row mb-4">
			<div class="col-md-3">
				<div class="card text-center">
					<div class="card-body">
						<h5 class="card-title">Total Bookings</h5>
						<h3>@Model.BookingStatistics["Total Bookings"]</h3>
					</div>
				</div>
			</div>
			<div class="col-md-3">
				<div class="card text-center">
					<div class="card-body">
						<h5 class="card-title">Confirmed</h5>
						<h3>@Model.BookingStatistics["Confirmed"]</h3>
					</div>
				</div>
			</div>
			<div class="col-md-3">
				<div class="card text-center">
					<div class="card-body">
						<h5 class="card-title">Cancelled</h5>
						<h3>@Model.BookingStatistics["Cancelled"]</h3>
					</div>
				</div>
			</div>
			<div class="col-md-3">
				<div class="card text-center">
					<div class="card-body">
						<h5 class="card-title">Completed</h5>
						<h3>@Model.BookingStatistics["Completed"]</h3>
					</div>
				</div>
			</div>
		</div>

		<div class="card">
			<div class="card-header">
				<h5 class="mb-0">Room Utilization</h5>
			</div>
			<div class="card-body">
				<div class="table-responsive">
					<table class="table table-striped">
						<thead>
							<tr>
								<th>Room Name</th>
								<th>Number of Bookings</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var utilization in Model.RoomUtilization)
							{
								<tr>
									<td>@utilization.RoomName</td>
									<td>
										<span class="badge bg-info">@utilization.BookingCount</span>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	}
	else
	{
		<div class="alert alert-info">No data available for the selected date range.</div>
	}
</div>
