@page
@model OverridesModel
@{
	ViewData["Title"] = "Booking Overrides";
}

<div class="container mt-4">
	<h2>Booking Overrides Management</h2>

	<div class="card mb-4">
		<div class="card-header">
			<h5 class="mb-0">Create Override</h5>
		</div>
		<div class="card-body">
			<form method="post">
				<div class="row">
					<div class="col-md-8">
						<div class="form-group">
							<label for="bookingId" class="form-label">Select Booking *</label>
							<select id="bookingId" name="bookingId" class="form-select" required>
								<option value="">-- Select a booking --</option>
								@foreach (var booking in Model.AvailableBookings)
								{
									<option value="@booking.Id">@booking.RoomName - @booking.BookingDate.ToString("dd/MM/yyyy") @booking.StartTime.ToString(@"hh\:mm")</option>
								}
							</select>
						</div>
					</div>
				</div>

				<div class="form-group">
					<label for="reason" class="form-label">Reason for Override *</label>
					<textarea id="reason" name="reason" class="form-control" rows="2" required></textarea>
				</div>

				<div class="form-check mb-3">
					<input class="form-check-input" type="checkbox" id="allowException" name="allowException" />
					<label class="form-check-label" for="allowException">
						This override allows exception to normal booking rules
					</label>
				</div>

				<div class="mt-3">
					<button type="submit" class="btn btn-primary">Create Override</button>
				</div>
			</form>
		</div>
	</div>

	<div class="card">
		<div class="card-header">
			<h5 class="mb-0">Active Overrides</h5>
		</div>
		<div class="card-body">
			@if (Model.Overrides.Any())
			{
				<div class="table-responsive">
					<table class="table table-striped">
						<thead>
							<tr>
								<th>Booking ID</th>
								<th>Reason</th>
								<th>Exception Allowed</th>
								<th>Created By</th>
								<th>Created At</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var bookingOverride in Model.Overrides)
							{
								<tr>
									<td>@bookingOverride.BookingId</td>
									<td>@bookingOverride.Reason</td>
									<td>
										@if (bookingOverride.AllowsExceptionToRule)
										{
											<span class="badge bg-success">Yes</span>
										}
										else
										{
											<span class="badge bg-secondary">No</span>
										}
									</td>
									<td>@bookingOverride.AdminId</td>
									<td>@bookingOverride.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			else
			{
				<p class="text-muted">No overrides created yet.</p>
			}
		</div>
	</div>
</div>
