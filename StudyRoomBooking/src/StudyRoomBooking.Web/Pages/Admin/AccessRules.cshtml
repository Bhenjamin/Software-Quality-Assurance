@page
@model AccessRulesModel
@{
	ViewData["Title"] = "Access Rules";
}

<div class="container mt-4">
	<h2>Access Rules Management</h2>

	<div class="card mb-4">
		<div class="card-header">
			<h5 class="mb-0">Create Access Rule</h5>
		</div>
		<div class="card-body">
			<form method="post">
				<div class="row">
					<div class="col-md-6">
						<div class="form-group">
							<label for="roomId" class="form-label">Select Room *</label>
							<select id="roomId" name="roomId" class="form-select" required>
								<option value="">-- Select a room --</option>
								@foreach (var room in Model.AvailableRooms)
								{
									<option value="@room.Id">@room.Name (@room.Code)</option>
								}
							</select>
						</div>
					</div>
				</div>

				<div class="row">
					<div class="col-md-6">
						<div class="form-group">
							<label for="ruleName" class="form-label">Rule Name *</label>
							<input type="text" id="ruleName" name="ruleName" class="form-control" required />
						</div>
					</div>
				</div>

				<div class="form-group">
					<label for="description" class="form-label">Description</label>
					<textarea id="description" name="description" class="form-control" rows="2"></textarea>
				</div>

				<div class="row">
					<div class="col-md-3">
						<div class="form-group">
							<label for="startTime" class="form-label">Start Time</label>
							<input type="time" id="startTime" name="startTime" class="form-control" />
						</div>
					</div>
					<div class="col-md-3">
						<div class="form-group">
							<label for="endTime" class="form-label">End Time</label>
							<input type="time" id="endTime" name="endTime" class="form-control" />
						</div>
					</div>
				</div>

				<div class="mt-3">
					<button type="submit" class="btn btn-primary">Create Rule</button>
				</div>
			</form>
		</div>
	</div>

	<div class="card">
		<div class="card-header">
			<h5 class="mb-0">Current Access Rules</h5>
		</div>
		<div class="card-body">
			@if (Model.AccessRules.Any())
			{
				<div class="table-responsive">
					<table class="table table-striped">
						<thead>
							<tr>
								<th>Room</th>
								<th>Rule Name</th>
								<th>Description</th>
								<th>Time Range</th>
								<th>Status</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var rule in Model.AccessRules)
							{
								<tr>
									<td>@rule.RuleName</td>
									<td>@rule.Description</td>
									<td>
										@if (rule.StartTime.HasValue && rule.EndTime.HasValue)
										{
											@rule.StartTime.Value.ToString(@"hh\:mm") <text>-</text> @rule.EndTime.Value.ToString(@"hh\:mm")
										}
										else
										{
											<text>No time restriction</text>
										}
									</td>
									<td>
										@if (rule.IsActive)
										{
											<span class="badge bg-success">Active</span>
										}
										else
										{
											<span class="badge bg-secondary">Inactive</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			else
			{
				<p class="text-muted">No access rules defined yet.</p>
			}
		</div>
	</div>
</div>
