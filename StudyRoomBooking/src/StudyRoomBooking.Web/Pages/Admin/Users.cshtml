@page
@model StudyRoomBooking.Web.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Users";
}

<h1>Users</h1>
<p class="text-muted">Read-only role visibility for Assessment 1 — permission editing is a later-phase feature.</p>

<table class="table table-striped">
    <thead>
        <tr><th>Name</th><th>Email</th><th>Role</th><th>Programme</th></tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Users)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>@user.Role</td>
                <td>@(user.Programme ?? "—")</td>
            </tr>
        }
    </tbody>
</table>
