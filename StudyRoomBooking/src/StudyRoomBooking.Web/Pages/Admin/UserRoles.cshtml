@page
@model UserRolesModel
@{
	ViewData["Title"] = "User Roles";
}

<div class="container mt-4">
	<div asp-validation-summary="All" class="text-danger"></div>
	<h2>User Roles Management</h2>

	@if (Model.Users.Any())
	{
		<div class="table-responsive">
			<table class="table table-striped">
				<thead>
					<tr>
						<th>User ID</th>
						<th>Name</th>
						<th>Email</th>
						<th>Current Role</th>
						<th>Major</th>
						<th>Email Status</th>
						<th>Access Level</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var user in Model.Users)
					{
						<tr>
							<td>@user.UserId</td>
							<td>@user.Name</td>
							<td>@user.Email</td>
							<td>
								@if (user.Role == StudyRoomBooking.Domain.Enums.UserRole.Student)
								{
									<span class="badge role-student">Student</span>
								}
								else if (user.Role == StudyRoomBooking.Domain.Enums.UserRole.Staff)
								{
									<span class="badge role-staff">Staff</span>
								}
								else
								{
									<span class="badge role-admin">Admin</span>
								}
							</td>
							<td>
								@if (user.Role == StudyRoomBooking.Domain.Enums.UserRole.Student && user.Major.HasValue)
								{
									@user.Major.Value
								}
								else
								{
									<span class="text-muted">Not applicable</span>
								}
							</td>
							<td>
								@if (user.IsActive)
								{
									<span class="badge bg-success">Active</span>
								}
								else
								{
									<span class="badge bg-secondary">Inactive</span>
								}
							</td>
							<td>
								<form method="post" class="d-inline">
									<select name="role" class="form-select role-select d-inline w-auto">
										@foreach (var role in Enum.GetValues<StudyRoomBooking.Domain.Enums.UserRole>())
										{
											<option value="@role" selected="@(user.Role == role)">@role</option>
										}
									</select>
									<button type="submit" class="btn btn-sm btn-primary" asp-page-handler="Edit" asp-route-id="@user.Id">Save Change</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
	else
	{
		<div class="alert alert-info">No users found.</div>
	}
</div>
