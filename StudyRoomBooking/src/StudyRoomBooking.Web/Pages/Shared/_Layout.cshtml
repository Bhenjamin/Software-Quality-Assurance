@inject StudyRoomBooking.Infrastructure.Localization.ILocalizationService localizationService
@{
    // Handle language selection from query parameter
    var langParam = Context.Request.Query["lang"].ToString();
    if (!string.IsNullOrEmpty(langParam) && (langParam == "en" || langParam == "vi"))
    {
        Context.Session.SetString("CurrentLanguage", langParam.ToUpper());
        localizationService.SetLanguage(langParam); // Update localization service
    }

    // Ensure CurrentLanguage is always set (default to EN)
    if (string.IsNullOrEmpty(Context.Session.GetString("CurrentLanguage")))
    {
        Context.Session.SetString("CurrentLanguage", "EN");
        localizationService.SetLanguage("en");
    }
    else
    {
        // Set the localization service to match the session language
        var sessionLang = Context.Session.GetString("CurrentLanguage")?.ToLower();
        if (!string.IsNullOrEmpty(sessionLang))
        {
            localizationService.SetLanguage(sessionLang);
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Study Room Booking System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StudyRoomBooking.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <span class="navbar-brand">Study Room Booking</span>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @{
                            var userRole = Context.Session.GetString("CurrentUserRole") ?? "";
                        }
                        @if (userRole == "Student" || userRole == "Staff" || userRole == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark @(Context.Request.Path == "/" ? "active" : "")" asp-area="" asp-page="/Index">Book a Room</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark @(Context.Request.Path.StartsWithSegments("/Students/MyBookings") ? "active" : "")" asp-area="" asp-page="/Students/MyBookings">@localizationService.GetString("Navigation", "MyBookings")</a>
                            </li>
                        }
                        @if (userRole == "Staff")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark @(Context.Request.Path.StartsWithSegments("/Staff/RecurringBooking") ? "active" : "")" asp-area="" asp-page="/Staff/RecurringBooking">@localizationService.GetString("Navigation", "RecurringBookings")</a>
                            </li>
                        }
                        @if (userRole == "Admin")
                        {
                            <li class="nav-item admin-nav-start">
                                <a class="nav-link text-dark @(Context.Request.Path.StartsWithSegments("/Admin/RoomManagement") ? "active" : "")" asp-area="" asp-page="/Admin/RoomManagement">@localizationService.GetString("Navigation", "RoomManagement")</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark @(Context.Request.Path.StartsWithSegments("/Admin/UserRoles") ? "active" : "")" asp-area="" asp-page="/Admin/UserRoles">@localizationService.GetString("Navigation", "UserRoles")</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark @(Context.Request.Path.StartsWithSegments("/Admin/BookingManagement") ? "active" : "")" asp-area="" asp-page="/Admin/BookingManagement">@localizationService.GetString("Navigation", "BookingManagement")</a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-3 ms-auto">
                        <!-- Language Selector -->
                        @{
                            var currentLang = Context.Session.GetString("CurrentLanguage") ?? "EN";
                            var langDisplay = currentLang.ToUpper();
                        }
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="languageMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                @langDisplay
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="languageMenu">
                                <li><a class="dropdown-item" href="?lang=en">English (EN)</a></li>
                                <li><a class="dropdown-item" href="?lang=vi">Tiếng Việt (VI)</a></li>
                            </ul>
                        </div>

                        <!-- User Account Menu (shows when logged in) -->
                        @if (Context.Session.GetString("CurrentUser") != null)
                        {
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                    @Context.Session.GetString("CurrentUser")
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
                                    <li>
                                        <a class="dropdown-item" asp-page="/Logout">
                                            @localizationService.GetString("Common", "Logout")
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                    </div>

            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Study Room Booking System
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
