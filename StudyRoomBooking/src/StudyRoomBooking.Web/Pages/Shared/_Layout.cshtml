@inject ICurrentUserAccessor CurrentUserAccessor
@{
    var currentUser = CurrentUserAccessor.GetCurrentUser();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Study Room Booking</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-md navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">Study Room Booking</a>
            <div class="navbar-nav me-auto">
                <a class="nav-link" href="/Rooms/Search">Search Rooms</a>
                @if (currentUser is not null)
                {
                    <a class="nav-link" href="/Bookings/History">My Bookings</a>
                }
                @if (currentUser is not null && currentUser.Role == UserRole.Administrator)
                {
                    <a class="nav-link" href="/Admin/Rooms">Manage Rooms</a>
                    <a class="nav-link" href="/Admin/BookingsOverview">All Bookings</a>
                    <a class="nav-link" href="/Admin/Users">Users</a>
                }
            </div>
            <span class="navbar-text text-light">
                @if (currentUser is not null)
                {
                    <text>Signed in as <strong>@currentUser.FullName</strong> (@currentUser.Role) &middot; </text>
                    <a class="link-light" href="/Index?handler=SwitchUser">Switch user</a>
                }
                else
                {
                    <a class="link-light" href="/">Select a user</a>
                }
            </span>
        </div>
    </nav>

    <div class="container">
        @if (TempData["Error"] is string errorMessage)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }
        @if (TempData["Success"] is string successMessage)
        {
            <div class="alert alert-success">@successMessage</div>
        }
        @RenderBody()
    </div>
</body>
</html>
