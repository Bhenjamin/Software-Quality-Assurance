@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1>Welcome to Study Room Booking System</h1>
            <p class="lead">Book study rooms, labs, and meeting spaces for your academic needs.</p>
        </div>
    </div>



    <div class="row mt-4">
        <div class="col-md-12">
            <h3>Available Rooms</h3>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Room Code</th>
                        <th>Room Name</th>
                        <th>Location</th>
                        <th>Capacity</th>
                        <th>Type</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody id="roomsTable">
                    <tr>
                        <td colspan="6" class="text-center">Loading rooms...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // This will be populated with room data from the page model
        document.addEventListener('DOMContentLoaded', function() {
            var rooms = @Html.Raw(Model.RoomsJson);
            if (rooms && rooms.length > 0) {
                var tbody = document.getElementById('roomsTable');
                tbody.innerHTML = '';
                rooms.forEach(function(room) {
                    var row = '<tr>' +
                        '<td>' + room.code + '</td>' +
                        '<td>' + room.name + '</td>' +
                        '<td>' + room.location + '</td>' +
                        '<td>' + room.capacity + '</td>' +
                        '<td>' + room.type + '</td>' +
                        '<td><span class="badge bg-success">Available</span></td>' +
                        '</tr>';
                    tbody.innerHTML += row;
                });
            }
        });
    </script>
}
