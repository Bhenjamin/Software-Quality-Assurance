@page
@model IndexModel
@{
	ViewData["Title"] = "Book a Room";
	var minDate = DateTime.Today.ToString("yyyy-MM-dd");
	var maxDate = DateTime.Today.AddDays(60).ToString("yyyy-MM-dd");
}

<style>
	.time-validation-error {
		display: none;
		color: #dc3545;
		font-size: 0.875rem;
		margin-top: 0.25rem;
	}
	.time-validation-error.show {
		display: block;
	}
	.time-label {
		width: 80px;
		flex-shrink: 0;
	}

	.booking-modal-dialog {
		max-width: 380px;
		width: 90%;
	}
	.room-details {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.calendar-slot-booked-self {
		display: block;
		width: 100%;
		height: 100%;
		box-sizing: border-box;
	}

	/* Merged slot styling */
	.calendar-slot-merged {
		/* Mark when a slot is the start of a merged group */
	}

	.calendar-slot-hidden {
		/* Hide subsequent slots in a merged group */
		display: none !important;
	}

	td.merged-slot-container {
		/* Container for merged slots */
		padding: 4px;
	}
</style>

<div class="container mt-4">
	@if (!ViewData.ModelState.IsValid)
	{
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			<strong>Booking Search Error</strong>
			<ul class="mb-0">
				@foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
				{
					<li>@error.ErrorMessage</li>
				}
			</ul>
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	<form method="post" class="card p-3 mb-3">
		<div class="d-flex align-items-end gap-4">
			<div style="flex: 1;">
				<div class="form-group">
					<label for="bookingDate" class="form-label">Date <small class="text-muted"> -  Today to 60 days ahead</small></label>
					<div class="input-group">
						<button type="button" id="dateBackBtn" class="btn btn-outline-secondary" title="Previous day">
							<i class="bi bi-chevron-down"></i> ◀
						</button>
						<input type="date" id="bookingDate" name="searchCriteria.BookingDate" 
							   min="@minDate" max="@maxDate"
							   value="@Model.SearchCriteria.BookingDate.ToString("yyyy-MM-dd")" class="form-control" required />
						<button type="button" id="dateForwardBtn" class="btn btn-outline-secondary" title="Next day">
							▶ <i class="bi bi-chevron-up"></i>
						</button>
					</div>
					
					<div id="dateWarning" class="alert alert-warning mt-2" style="display: none; padding: 0.5rem 0.75rem; margin: 0.5rem 0;">
						Cannot go to past date. Today is selected.
					</div>
				</div>
			</div>
			@* <div class="col-md-3" style="width: 120px;">
				<div class="form-group">
					<label for="startTime" class="form-label">Start Hour</label>
					<select id="startTime" name="searchCriteria.StartTime" class="form-select">
						<option value="" selected="@(!Model.SearchCriteria.StartTime.HasValue)">--:--</option>
						@for (int hour = 8; hour <= 21; hour++)
						{
							<option value="@hour:00" selected="@(Model.SearchCriteria.StartTime.HasValue && Model.SearchCriteria.StartTime.Value.Hours == hour)">@hour:00</option>
						}
					</select>
				</div>
			</div>
			<div class="col-md-3" style="width: 120px;">
				<div class="form-group">
					<label for="endTime" class="form-label">End Hour</label>
					<select id="endTime" name="searchCriteria.EndTime" class="form-select">
						<option value="" selected="@(!Model.SearchCriteria.EndTime.HasValue)">--:--</option>
						@for (int hour = 9; hour <= 22; hour++)
						{
							<option value="@hour:00" selected="@(Model.SearchCriteria.EndTime.HasValue && Model.SearchCriteria.EndTime.Value.Hours == hour)">@hour:00</option>
						}
					</select>
					<div id="timeValidationError" class="time-validation-error">Start hour must be before end hour.</div>
				</div>
			</div> *@

			<div style="flex: 1;">
				<div class="form-group">
					<label for="roomType" class="form-label">Room Type</label>
					<select id="roomType" name="searchCriteria.RoomType" class="form-select">
						<option value="">Any</option>
						@foreach (var type in Model.AvailableRoomTypes)
						{
							<option value="@type" selected="@(Model.SearchCriteria.RoomType == type)">@type.ToDisplayName()</option>
						}
					</select>
				</div>
			</div>
			<div style="flex: 1;">
				<div class="form-group">
					<label for="location" class="form-label">Location</label>
					<select id="location" name="searchCriteria.Location" class="form-select">
						<option value="">Any</option>
						@foreach (var building in Model.AvailableBuildings)
						{
							<option value="Building @building" selected="@(Model.SearchCriteria.Location == "Building " + building.ToString())">Building @building</option>
						}
					</select>
				</div>
			</div>
		</div>
	</form>

	@if (Model.SearchResults.Any())
	{
		<div class="card mt-4">
			<div class="card-header">
				<div style="display: flex; justify-content: flex-start; align-items: flex-start; gap: 40px;">
					<div style="width: 55%;">
						<h5 class="mb-0">Available Rooms for @Model.SearchCriteria.BookingDate.ToString("dddd, MMMM dd, yyyy")</h5>
						<small class="text-muted">Time Range: 08:00 - 22:00</small>
					</div>
					<div style="width: 45%; display: grid; grid-template-columns: 2fr 1fr; gap: 10px; font-size: 0.9rem;">
						<div style="display: flex; align-items: flex-start; gap: 10px;">
							<span style="display: inline-block; width: 20px; height: 20px; background-color: var(--success); border-radius: 3px; flex-shrink: 0; margin-top: 2px;"></span>
							<div style="font-weight: 600;">Available - Click to book</div>
						</div>
						<div style="display: flex; align-items: flex-start; gap: 10px;">
							<span style="display: inline-block; width: 20px; height: 20px; background-color: var(--delete); border-radius: 3px; flex-shrink: 0; margin-top: 2px;"></span>
							<div style="font-weight: 600;">Booked</div>
						</div>
						<div style="display: flex; align-items: flex-start; gap: 10px;">
							<span style="display: inline-block; width: 20px; height: 20px; background-color: #2563EB; border-radius: 3px; flex-shrink: 0; margin-top: 2px;"></span>
							<div style="font-weight: 600;">Your Booking - Click to view/modify</div>
						</div>
						<div style="display: flex; align-items: flex-start; gap: 10px;">
							<span style="display: inline-block; width: 20px; height: 20px; background-color: #9CA3AF; border-radius: 3px; flex-shrink: 0; margin-top: 2px;"></span>
							<div style="font-weight: 600;">Unavailable</div>
						</div>
					</div>
				</div>
			</div>
			<div class="card-body">
				<div class="table-responsive">
					<table class="table table-bordered text-center">
						<thead>
							<tr class="table-light">
								<th style="width: 120px;">Room Details</th>
								@{
									var startTime = new TimeSpan(8, 0, 0);  // Always start from 8:00
									var endTime = new TimeSpan(22, 0, 0);  // Always end at 22:00
									var interval = TimeSpan.FromHours(1);
									var currentTime = startTime;
									var timeSlots = new List<TimeSpan>();

									while (currentTime < endTime)
									{
										timeSlots.Add(currentTime);
										currentTime = currentTime.Add(interval);
									}
								}
								@foreach (var timeSlot in timeSlots)
								{
									<th>@timeSlot.ToString(@"hh\:mm")</th>
								}
								</tr>
						</thead>
						<tbody>
							@foreach (var room in Model.SearchResults)
							{
								<tr>
									<td class="text-start" style="vertical-align: middle;">
										<div>
											<strong>@room.Name</strong><br />
											<small class="text-muted">@room.Code<br />@room.Location<br />Cap: @room.Capacity</small>
										</div>
									</td>
									@{
										var bookingsForRoom = await Model.GetRoomBookingsAsync(room.Id, Model.SearchCriteria.BookingDate);
									}
									@foreach (var timeSlot in timeSlots)
									{
										var nextTime = timeSlot.Add(interval);
										var bookedSlot = bookingsForRoom.FirstOrDefault(b => 
											!(b.EndTime <= timeSlot || b.StartTime >= nextTime) && 
											b.Status != StudyRoomBooking.Domain.Enums.BookingStatus.Cancelled);
										var isBooked = bookedSlot != null;
										var isOwnBooking = isBooked && bookedSlot.UserId == Model.CurrentUserId;
										var isInSearchRange = Model.IsTimeSlotInSearchRange(timeSlot);
										var isInPast = Model.IsTimeSlotInPast(timeSlot);
										var startHour = timeSlot.Hours;
										var endHour = nextTime.Hours;

										<td style="padding: 4px;">
											@if (isInSearchRange && !isInPast)
											{
												@if (isBooked)
												{
													@if (isOwnBooking)
													{
														<a asp-page="/Students/ModifyBooking" asp-route-id="@bookedSlot.Id" class="badge calendar-slot calendar-slot-booked-self" data-booking-id="@bookedSlot.Id" style="text-decoration: none; cursor: pointer;"></a>
													}
													else
													{
														<span class="badge calendar-slot calendar-slot-booked"></span>
													}
												}
												else
												{
													<button type="button" class="badge calendar-slot calendar-slot-free" onclick="openBookingModal(@room.Id, '@Model.SearchCriteria.BookingDate.ToString("yyyy-MM-dd")', '@(startHour.ToString().PadLeft(2, '0')):00', '@(endHour.ToString().PadLeft(2, '0')):00', '@room.Name', {Name: '@room.Name', Code: '@room.Code', Location: '@room.Location', Capacity: @room.Capacity})" style="border: none; background: none; padding: 0; cursor: pointer;"> </button>
												}
											}
											else
											{
												<span class="badge calendar-slot calendar-slot-unavailable"> </span>
											}
										</td>
												}
											</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>

		<style>
			.room-matrix table {
				font-size: 0.9rem;
			}
			.room-matrix .badge {
				font-size: 0.75rem;
				padding: 4px 8px;
			}
			.room-matrix th {
				background-color: #f8f9fa;
				padding: 8px 4px;
				font-size: 0.85rem;
			}
			.room-matrix td {
				padding: 8px 4px;
				height: auto;
			}
		</style>
	}
	else if (Model.HasSearched)
	{
		<div class="alert alert-info">No available rooms found for the selected criteria.</div>
	}
</div>

<!-- Booking Modal -->
<div class="modal fade" id="bookingModal" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true">
	<div class="modal-dialog booking-modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="bookingModalLabel">Book a Room</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<div id="modalBookingAlert" class="alert alert-danger alert-dismissible fade show" role="alert" style="display: none;">
					<strong>Booking Error!</strong>
					<div id="modalBookingErrors"></div>
					<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
				</div>
				<form id="bookingForm">
					@Html.AntiForgeryToken()
					<div class="row">
						<!-- Left column: Room Details -->
						<div class="col-5">
							<strong style="font-size: 1rem;" id="modalRoomNameDetail"></strong>

							<small class="text-muted room-details" style="font-size: 1rem;">
								<span id="modalRoomCode"></span>
								<span id="modalRoomLocation"></span>
								<span>Capacity: <span id="modalRoomCapacity"></span></span>
							</small>
						</div>
						<!-- Vertical divider -->
						<div class="col-1 d-flex justify-content-center">
							<div style="border-left: 1px solid #dee2e6; height: 100%;"></div>
						</div>
						<!-- Right column: Booking Details -->
						<div class="col-5">
							<div class="mb-0">
								<label class="form-label" style="font-size: 0.9rem; font-weight: 600;">Date: <span id="modalBookingDateDisplay"></span></label>
							</div>
							<div class="mb-0 d-flex align-items-center gap-2">
								<label for="modalStartTime" class="form-label mb-0 time-label" style="font-size: 0.9rem;">Start Hour:</label>
								<select id="modalStartTime" class="form-select form-select-sm" style="width: 80px;" required></select>
							</div>
							<div class="mb-0 d-flex align-items-center gap-2">
								<label for="modalEndTime" class="form-label mb-0 time-label" style="font-size: 0.9rem;">End Hour:</label>
								<select id="modalEndTime" class="form-select form-select-sm" style="width: 80px;" required></select>
								<div id="modalTimeValidationError" class="time-validation-error"></div>
							</div>
						</div>
					</div>
					<input type="hidden" id="modalRoomId">
					<input type="hidden" id="modalBookingDate">
					<input type="hidden" id="modalStartTimeHidden">
					<input type="hidden" id="modalEndTimeHidden">
				</form>
			</div>
			<div class="modal-footer justify-content-start">
				<button type="button" class="btn btn-primary" id="submitBookingBtn">Confirm Booking</button>
			</div>
		</div>
	</div>
</div>

<!-- Modify Booking Modal -->
<div class="modal fade" id="modifyBookingModal" tabindex="-1" aria-labelledby="modifyBookingModalLabel" aria-hidden="true">
	<div class="modal-dialog booking-modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="modifyBookingModalLabel">Modify Booking</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<div id="modifyBookingAlert" class="alert alert-danger alert-dismissible fade show" role="alert" style="display: none;">
					<strong>Modification Error!</strong>
					<div id="modifyBookingErrors"></div>
					<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
				</div>
				<form id="modifyBookingForm">
					@Html.AntiForgeryToken()
					<div class="row">
						<!-- Left column: Room Details -->
						<div class="col-5">
							<strong style="font-size: 1rem;" id="modifyModalRoomNameDetail"></strong>

							<small class="text-muted room-details" style="font-size: 0.9rem;">
								<div id="modifyModalRoomCode"></div>
								<div id="modifyModalRoomLocation"></div>
								<div>Capacity: <span id="modifyModalRoomCapacity"></span></div>
							</small>
						</div>
						<!-- Vertical divider -->
						<div class="col-1 d-flex justify-content-center">
							<div style="border-left: 1px solid #dee2e6; height: 100%;"></div>
						</div>
						<!-- Right column: Booking Details -->
						<div class="col-5">
							<div class="mb-0">
								<label class="form-label" style="font-size: 0.9rem; font-weight: 600;">Date: <span id="modifyModalBookingDateDisplay"></span></label>
							</div>
							<div class="mb-2 d-flex align-items-center gap-2">
								<label for="modifyModalStartTime" class="form-label mb-0 time-label" style="font-size: 0.9rem;">Start Hour:</label>
								<select id="modifyModalStartTime" class="form-select form-select-sm" style="width: 80px;" required></select>
							</div>
							<div class="mb-2 d-flex align-items-center gap-2">
								<label for="modifyModalEndTime" class="form-label mb-0 time-label" style="font-size: 0.9rem;">End Hour:</label>
								<select id="modifyModalEndTime" class="form-select form-select-sm" style="width: 80px;" required></select>
							</div>
							<div id="modifyModalTimeValidationError" class="time-validation-error"></div>
						</div>
					</div>
					<input type="hidden" id="modifyModalBookingId">
				</form>
			</div>
			<div class="modal-footer justify-content-start">
				<button type="button" class="btn btn-primary btn-sm" id="submitModifyBookingBtn">Save Changes</button>
				<button type="button" class="btn btn-danger btn-sm" id="deleteModifyBookingBtn">Delete</button>
			</div>
		</div>
	</div>
</div>

<script>
// Store booking details globally
let globalBookingData = {
	roomId: null,
	bookingDate: null,
	startTime: null,
	endTime: null,
	roomName: null,
	notes: null
};

// Store room availability matrix: roomId -> { hour -> isAvailable }
let roomAvailabilityMatrix = {};

document.addEventListener('DOMContentLoaded', function() {
	// Build room availability matrix from the table
	buildRoomAvailabilityMatrix();

	// Function to build availability matrix from the room matrix table
	function buildRoomAvailabilityMatrix() {
		const table = document.querySelector('table.table');
		if (!table) return;

		const rows = table.querySelectorAll('tbody tr');
		rows.forEach(row => {
			// Extract room ID from the first button in this row
			const firstButton = row.querySelector('button[onclick*="openBookingModal"]');
			if (!firstButton) return;

			const onclickAttr = firstButton.getAttribute('onclick');
			const roomIdMatch = onclickAttr.match(/openBookingModal\((\d+)/);
			if (!roomIdMatch) return;

			const roomId = parseInt(roomIdMatch[1]);
			if (!roomAvailabilityMatrix[roomId]) {
				roomAvailabilityMatrix[roomId] = {};
			}

			// Scan each time slot column (skip first column which is room name)
			const cells = row.querySelectorAll('td');
			for (let i = 1; i < cells.length; i++) {
				const cell = cells[i];
				// Check if this cell has a free slot button
				const hasButton = cell.querySelector('button.calendar-slot-free');
				const hour = 8 + (i - 1); // Hours start at 8
				roomAvailabilityMatrix[roomId][hour] = hasButton ? true : false;
			}
		});
	}

	// Modal booking functions
	window.openBookingModal = async function(roomId, bookingDate, startTime, endTime, roomName, room = null) {
		try {
			// Fetch room details if not provided
			if (!room) {
				room = { Name: roomName };
			}

			// Store booking data
			globalBookingData.roomId = roomId;
			globalBookingData.bookingDate = bookingDate;
			globalBookingData.startTime = startTime;
			globalBookingData.endTime = endTime;
			globalBookingData.roomName = roomName;

			// Set room details in modal
			document.getElementById('modalRoomNameDetail').textContent = room.Name;
			document.getElementById('modalRoomCode').textContent = room.Code || '';
			document.getElementById('modalRoomLocation').textContent = room.Location || '';
			document.getElementById('modalRoomCapacity').textContent = room.Capacity || '';

			// Format date as dd-mm-yyyy
			const dateObj = new Date(bookingDate);
			const day = String(dateObj.getDate()).padStart(2, '0');
			const month = String(dateObj.getMonth() + 1).padStart(2, '0');
			const year = dateObj.getFullYear();
			document.getElementById('modalBookingDateDisplay').textContent = `${day}-${month}-${year}`;

			// Populate Start Hour dropdown with default selected
			populateStartHourDropdown(startTime);

			// Populate End Hour dropdown with default selected
			populateEndHourDropdown(endTime);

			// Set hidden fields
			document.getElementById('modalRoomId').value = roomId;
			document.getElementById('modalBookingDate').value = bookingDate;
			document.getElementById('modalStartTimeHidden').value = startTime;
			document.getElementById('modalEndTimeHidden').value = endTime;

			// Reset alerts
			document.getElementById('modalBookingAlert').style.display = 'none';

			// Re-enable submit button for new booking
			document.getElementById('submitBookingBtn').disabled = false;

			// Show modal
			const bookingModal = new bootstrap.Modal(document.getElementById('bookingModal'));
			bookingModal.show();
		} catch (error) {
			console.error('Error opening booking modal:', error);
		}
	};

	// Populate Start Hour dropdown with only available time slots
	function populateStartHourDropdown(defaultValue) {
		const startSelect = document.getElementById('modalStartTime');
		startSelect.innerHTML = '';

		const roomId = globalBookingData.roomId;
		const roomAvailability = roomAvailabilityMatrix[roomId] || {};

		let firstAvailable = null;

		// Start hours from 08:00 to 21:00
		for (let hour = 8; hour <= 21; hour++) {

			// This one-hour slot must be available
			if (roomAvailability[hour] !== true) {
				continue;
			}

			const timeStr = `${hour.toString().padStart(2, '0')}:00`;

			const option = document.createElement('option');
			option.value = timeStr;
			option.textContent = timeStr;

			// Keep the clicked slot selected if it is available
			if (timeStr === defaultValue) {
				option.selected = true;
			}

			startSelect.appendChild(option);

			if (!firstAvailable) {
				firstAvailable = timeStr;
			}
		}

		// If clicked/default time is not available, select first available slot
		if (startSelect.options.length > 0 && !startSelect.value) {
			startSelect.value = firstAvailable;
		}

		// Populate end time based on selected start time
		if (startSelect.value) {
			const startHour = parseInt(startSelect.value.split(':')[0]);
			const endTimeStr = `${String(startHour + 1).padStart(2, '0')}:00`;
			populateEndHourDropdown(endTimeStr);
		}
	}

	// Populate End Hour dropdown - show only available hours (up to 2 options: start+1 and start+2)
	function populateEndHourDropdown(defaultValue) {
		const endSelect = document.getElementById('modalEndTime');
		endSelect.innerHTML = ''; // Clear existing options

		// Get the currently selected start time
		const startTimeStr = document.getElementById('modalStartTime').value;

		if (!startTimeStr) {
			return; // Don't populate if no start time selected
		}

		const startHour = parseInt(startTimeStr.split(':')[0]);
		const roomId = globalBookingData.roomId;

		// Get availability data for this room
		const roomAvailability = roomAvailabilityMatrix[roomId] || {};

		// Add only up to 2 available options: start+1 and start+2
		let addedCount = 0;
		for (let endHour = startHour + 1; endHour <= startHour + 2 && endHour <= 22 && addedCount < 2; endHour++) {
			// Check if ALL slots from startHour to endHour-1 are available
			let allSlotsAvailable = true;
			for (let slotHour = startHour; slotHour < endHour; slotHour++) {
				if (roomAvailability[slotHour] === false) {
					allSlotsAvailable = false;
					break;
				}
			}

			if (allSlotsAvailable) {
				const timeStr = `${endHour.toString().padStart(2, '0')}:00`;
				const option = document.createElement('option');
				option.value = timeStr;
				option.textContent = timeStr;
				if (timeStr === defaultValue || addedCount === 0) {
					option.selected = true;
				}
				endSelect.appendChild(option);
				addedCount++;
			}
		}
	}

	// Handle start time change
	document.getElementById('modalStartTime').addEventListener('change', function() {
		const selectedStartTime = this.value;
		if (selectedStartTime) {
			const startHour = parseInt(selectedStartTime.split(':')[0]);
			// Auto-adjust end time to start + 1 hour
			const endTimeStr = `${String(startHour + 1).padStart(2, '0')}:00`;
			// Repopulate end time dropdown with only 2 options
			populateEndHourDropdown(endTimeStr);
			// Set the end time to start + 1
			document.getElementById('modalEndTime').value = endTimeStr;
		}
	});

	// Handle booking form submission via AJAX
	document.getElementById('submitBookingBtn').addEventListener('click', function() {
		// Get values from dropdowns if they exist, otherwise use stored values
		const startTimeFromSelect = document.getElementById('modalStartTime').value;
		const endTimeFromSelect = document.getElementById('modalEndTime').value;

		const startTime = startTimeFromSelect || globalBookingData.startTime;
		const endTime = endTimeFromSelect || globalBookingData.endTime;

		// Validate times
		if (!startTime || !endTime) {
			document.getElementById('modalTimeValidationError').textContent = 'Please select both start and end times.';
			document.getElementById('modalTimeValidationError').style.display = 'block';
			return;
		}

		const startHour = parseInt(startTime.split(':')[0]);
		const endHour = parseInt(endTime.split(':')[0]);
		if (startHour >= endHour) {
			document.getElementById('modalTimeValidationError').textContent = 'Start hour must be before end hour.';
			document.getElementById('modalTimeValidationError').style.display = 'block';
			return;
		}
		document.getElementById('modalTimeValidationError').style.display = 'none';

		const roomId = globalBookingData.roomId;
		const bookingDate = globalBookingData.bookingDate;

		// Disable submit button during submission
		document.getElementById('submitBookingBtn').disabled = true;

		// Get antiforgery token
		const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
		const token = tokenInput ? tokenInput.value : '';

		// Prepare form data
		const params = new URLSearchParams();
		params.append('roomId', roomId);
		params.append('bookingDate', bookingDate);
		params.append('startTime', startTime);
		params.append('endTime', endTime);
		params.append('notes', '');
		params.append('__RequestVerificationToken', token);

		// Submit booking via AJAX
		fetch('?handler=BookRoom', {
			method: 'POST',
			headers: {
				'Content-Type': 'application/x-www-form-urlencoded',
				'X-Requested-With': 'XMLHttpRequest'
			},
			body: params.toString()
		})
		.then(response => {
			console.log('Response status:', response.status);
			if (!response.ok) {
				// For non-OK responses, try to get the error message from the response
				return response.text().then(text => {
					try {
						const data = JSON.parse(text);
						throw new Error(data.error || 'You already have a booking during this time. Please choose a different time.');
					} catch (parseError) {
						// If it's already an Error from above, re-throw it
						if (parseError instanceof Error && parseError.message !== 'Unexpected token' && parseError.message !== 'Unexpected end of JSON input') {
							throw parseError;
						}
						throw new Error('You already have a booking during this time. Please choose a different time.');
					}
				});
			}
			return response.json();
		})
		.then(data => {
			if (data.success) {
				// Close modal without showing success message in it
				const bookingModal = bootstrap.Modal.getInstance(document.getElementById('bookingModal'));
				bookingModal.hide();

				// Update the slot color to blue (user's booking)
				updateSlotColor(roomId, bookingDate, startTime, endTime, data.bookingId);

				// Merge consecutive booking slots after the slot color update
				mergeConsecutiveBookingSlots();

				// Show success message on main page
				showSuccessBanner(data.roomName, bookingDate, data.startTime, data.endTime, data.confirmationNumber);

				// Reset form
				document.getElementById('bookingForm').reset();
			} else {
				// Show error message in modal
				document.getElementById('modalBookingAlert').style.display = 'block';
				document.getElementById('modalBookingErrors').innerHTML = `<div>${data.error}</div>`;
				document.getElementById('submitBookingBtn').disabled = false;
			}
		})
		.catch(error => {
			console.error('Error:', error);
			document.getElementById('modalBookingAlert').style.display = 'block';
			document.getElementById('modalBookingErrors').innerHTML = `<div>${error.message}</div>`;
			document.getElementById('submitBookingBtn').disabled = false;
		});
	});

	// Update slot color to blue after successful booking
	function updateSlotColor(roomId, bookingDate, startTime, endTime, bookingId) {
		const startHour = parseInt(startTime.split(':')[0]);
		const endHour = parseInt(endTime.split(':')[0]);

		const buttons = document.querySelectorAll(
			`button[onclick*="openBookingModal(${roomId}"]`
		);

		buttons.forEach(btn => {
			const onclickAttr = btn.getAttribute('onclick');

			// Make sure this is the correct booking date
			if (!onclickAttr.includes(`'${bookingDate}'`)) {
				return;
			}

			// Extract the start hour of this table slot
			const match = onclickAttr.match(
				/openBookingModal\(\d+,\s*'[^']+',\s*'(\d{2}):00',\s*'(\d{2}):00'/
			);

			if (!match) {
				return;
			}

			const slotStartHour = parseInt(match[1]);
			const slotEndHour = parseInt(match[2]);

			// Check whether this table slot is inside the booking range
			if (slotStartHour >= startHour && slotEndHour <= endHour) {

				const link = document.createElement('a');

				// Match the Razor-generated ModifyBooking URL
				link.href = `/Students/ModifyBooking/${bookingId}`;

				link.className =
					'badge calendar-slot calendar-slot-booked-self';

				link.setAttribute('data-booking-id', bookingId);

				link.style.textDecoration = 'none';
				link.style.cursor = 'pointer';
				link.style.display = 'block';
				link.style.width = '100%';
				link.style.height = '100%';
				link.style.boxSizing = 'border-box';

				// Replace green available button with blue booking link
				btn.parentNode.replaceChild(link, btn);
			}
		});

		// Update frontend availability matrix
		if (!roomAvailabilityMatrix[roomId]) {
			roomAvailabilityMatrix[roomId] = {};
		}

		for (let hour = startHour; hour < endHour; hour++) {
			roomAvailabilityMatrix[roomId][hour] = false;
		}
	}

	// Show success banner on search page
	function showSuccessBanner(roomName, bookingDate, startTime, endTime, confirmationNumber) {
		const banner = document.createElement('div');
		banner.className = 'alert alert-success alert-dismissible fade show';
		banner.style.position = 'fixed';
		banner.style.top = '20px';
		banner.style.right = '20px';
		banner.style.zIndex = '9999';
		banner.style.minWidth = '300px';

		// Format date as dd-mm-yyyy
		const dateObj = new Date(bookingDate);
		const day = String(dateObj.getDate()).padStart(2, '0');
		const month = String(dateObj.getMonth() + 1).padStart(2, '0');
		const year = dateObj.getFullYear();
		const formattedDate = `${day}-${month}-${year}`;

		// Determine header based on confirmation number
		const isModify = confirmationNumber === 'Booking Updated';
		const headerText = isModify ? 'Booking Updated!' : 'Booking Confirmed!';
		const labelText = isModify ? 'Updated' : 'Confirmation #';

		banner.innerHTML = `
			<strong>${headerText}</strong>
			<div style="margin-top: 8px; font-size: 0.9rem;">
				<div>Room: <strong>${roomName}</strong></div>
				<div>Date: <strong>${formattedDate}</strong></div>
				<div>Time: <strong>${startTime} - ${endTime}</strong></div>
				<div style="margin-top: 4px;">${labelText}: <strong>${confirmationNumber}</strong></div>
			</div>
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		`;

		document.body.appendChild(banner);

		// Auto-dismiss after 5 seconds
		setTimeout(() => {
			banner.remove();
		}, 5000);
	}

	// Date navigation buttons
	const bookingDateInput = document.getElementById('bookingDate');
	const dateBackBtn = document.getElementById('dateBackBtn');
	const dateForwardBtn = document.getElementById('dateForwardBtn');
	const dateWarning = document.getElementById('dateWarning');

	function updateDateButtons() {
		const currentDate = bookingDateInput.value;
		const minDate = bookingDateInput.getAttribute('min');
		const maxDate = bookingDateInput.getAttribute('max');

		dateBackBtn.disabled = currentDate <= minDate;
		dateForwardBtn.disabled = currentDate >= maxDate;
	}

	dateBackBtn.addEventListener('click', function(e) {
		e.preventDefault();

		const currentDate = bookingDateInput.value;
		const minDate = bookingDateInput.getAttribute('min');

		// Convert yyyy-MM-dd safely
		const [year, month, day] = currentDate.split('-').map(Number);
		const previousDate = new Date(year, month - 1, day);
		previousDate.setDate(previousDate.getDate() - 1);

		const previousDateStr =
			previousDate.getFullYear() + '-' +
			String(previousDate.getMonth() + 1).padStart(2, '0') + '-' +
			String(previousDate.getDate()).padStart(2, '0');

		if (previousDateStr < minDate) {
			dateWarning.textContent =
				'Cannot go to past date. Today is selected.';
			dateWarning.style.display = 'block';

			setTimeout(() => {
				dateWarning.style.display = 'none';
			}, 3000);

			return;
		}

		bookingDateInput.value = previousDateStr;
		dateWarning.style.display = 'none';

		updateDateButtons();
		autoSubmitSearch();
	});

	dateForwardBtn.addEventListener('click', function(e) {
		e.preventDefault();

		const currentDate = bookingDateInput.value;
		const maxDate = bookingDateInput.getAttribute('max');

		const [year, month, day] = currentDate.split('-').map(Number);
		const nextDate = new Date(year, month - 1, day);
		nextDate.setDate(nextDate.getDate() + 1);

		const nextDateStr =
			nextDate.getFullYear() + '-' +
			String(nextDate.getMonth() + 1).padStart(2, '0') + '-' +
			String(nextDate.getDate()).padStart(2, '0');

		if (nextDateStr > maxDate) {
			return;
		}

		bookingDateInput.value = nextDateStr;
		dateWarning.style.display = 'none';

		updateDateButtons();
		autoSubmitSearch();
	});

	// Update button state when date is manually selected
	bookingDateInput.addEventListener('change', function() {
		updateDateButtons();
		autoSubmitSearch();
	});

	// Auto-submit form when any search input changes
	function autoSubmitSearch() {
		const form = document.querySelector('form');
		if (form) {
			form.submit();
		}
	}

	// Add event listeners to all search inputs to auto-submit
	const searchForm = document.querySelector('form');
	if (searchForm) {
		// Date input
		bookingDateInput.addEventListener('change', autoSubmitSearch);

		// Time inputs
		const startTimeInput = document.getElementById('startTime');
		const endTimeInput = document.getElementById('endTime');
		if (startTimeInput) startTimeInput.addEventListener('change', autoSubmitSearch);
		if (endTimeInput) endTimeInput.addEventListener('change', autoSubmitSearch);

		// Room type input
		const roomTypeInput = document.getElementById('roomType');
		if (roomTypeInput) roomTypeInput.addEventListener('change', autoSubmitSearch);

		// Location input (now a dropdown)
		const locationInput = document.getElementById('location');
		if (locationInput) locationInput.addEventListener('change', autoSubmitSearch);
	}

	// Merge consecutive booking slots with the same booking ID
	function mergeConsecutiveBookingSlots() {
		const table = document.querySelector('table.table');
		if (!table) return;

		const rows = table.querySelectorAll('tbody tr');
		rows.forEach(row => {
			// Get all blue booking links in this row
			const bookingLinks = row.querySelectorAll('a.calendar-slot-booked-self');
			if (bookingLinks.length === 0) return;

			// Group consecutive links by booking ID
			let currentGroup = [];
			let lastBookingId = null;

			bookingLinks.forEach((link, index) => {
				const bookingId = link.getAttribute('data-booking-id');

				if (bookingId === lastBookingId) {
					// Same booking, add to current group
					currentGroup.push(link);
				} else {
					// Different booking or first iteration
					if (currentGroup.length > 1) {
						// Merge the previous group
						mergeSlotGroup(currentGroup);
					}
					currentGroup = [link];
					lastBookingId = bookingId;
				}
			});

			// Handle the last group
			if (currentGroup.length > 1) {
				mergeSlotGroup(currentGroup);
			}
		});
	}

	// Merge a group of slots by setting colspan on first and hiding rest
	function mergeSlotGroup(slotGroup) {
		if (slotGroup.length < 2) return;

		const firstTd = slotGroup[0].closest('td');
		if (!firstTd) return;

		// Set colspan on the first TD
		const colspan = slotGroup.length;
		firstTd.setAttribute('colspan', colspan);
		firstTd.classList.add('merged-slot-container');

		// Hide all other TDs in the group
		for (let i = 1; i < slotGroup.length; i++) {
			const td = slotGroup[i].closest('td');
			if (td) {
				td.classList.add('calendar-slot-hidden');
				slotGroup[i].classList.add('calendar-slot-merged');
			}
		}
	}

	// Call merge on page load
	mergeConsecutiveBookingSlots();

	// Initial button state
	updateDateButtons();

	// ================== MODIFY BOOKING MODAL FUNCTIONS ==================

	// Store old booking data for comparison
	let globalModifyBookingData = {
		bookingId: null,
		roomId: null,
		roomName: null,
		bookingDate: null,
		startTime: null,
		endTime: null,
		notes: null
	};

	// Handle clicks on blue booking slots to open modify modal
	document.addEventListener('click', async function(e) {
		const bookingLink = e.target.closest('a.calendar-slot-booked-self');
		if (bookingLink) {
			e.preventDefault();
			const bookingId = bookingLink.getAttribute('data-booking-id');
			if (bookingId) {
				await openModifyBookingModal(parseInt(bookingId));
			}
		}
	});

	// Open modify modal and fetch booking details
	window.openModifyBookingModal = async function(bookingId) {
		try {
			// Fetch booking details via AJAX
			const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
			const token = tokenInput ? tokenInput.value : '';

			const params = new URLSearchParams();
			params.append('bookingId', bookingId);
			params.append('__RequestVerificationToken', token);

			const response = await fetch('?handler=GetBookingDetails', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/x-www-form-urlencoded',
					'X-Requested-With': 'XMLHttpRequest'
				},
				body: params.toString()
			});

			if (!response.ok) {
				const errorText = await response.text();
				throw new Error(errorText || 'Failed to fetch booking details');
			}

			const data = await response.json();

			if (!data.success) {
				alert('Error: ' + (data.error || 'Failed to fetch booking details'));
				return;
			}

			const booking = data.booking;

			// Store booking data
			globalModifyBookingData.bookingId = booking.id;
			globalModifyBookingData.roomId = booking.roomId;
			globalModifyBookingData.roomName = booking.roomName;
			globalModifyBookingData.bookingDate = booking.bookingDate;
			globalModifyBookingData.startTime = booking.startTime;
			globalModifyBookingData.endTime = booking.endTime;
			globalModifyBookingData.notes = booking.notes;

			// Populate room details
			document.getElementById('modifyModalRoomNameDetail').textContent = booking.roomName;
			document.getElementById('modifyModalRoomCode').textContent = booking.roomCode;
			document.getElementById('modifyModalRoomLocation').textContent = booking.roomLocation;
			document.getElementById('modifyModalRoomCapacity').textContent = booking.roomCapacity;

			// Populate form fields
			document.getElementById('modifyModalBookingId').value = booking.id;

			// Format date as dd-mm-yyyy for display
			const dateObj = new Date(booking.bookingDate);
			const day = String(dateObj.getDate()).padStart(2, '0');
			const month = String(dateObj.getMonth() + 1).padStart(2, '0');
			const year = dateObj.getFullYear();
			document.getElementById('modifyModalBookingDateDisplay').textContent = `${day}-${month}-${year}`;

			// Populate start and end time dropdowns
			populateModifyStartHourDropdown(booking.startTime);
			populateModifyEndHourDropdown(booking.endTime);

			// Reset alerts
			document.getElementById('modifyBookingAlert').style.display = 'none';

			// Show modal
			const modifyModal = new bootstrap.Modal(document.getElementById('modifyBookingModal'));
			modifyModal.show();

		} catch (error) {
			console.error('Error opening modify modal:', error);
			alert('Error: ' + error.message);
		}
	};

	// Populate modify start hour dropdown
	function populateModifyStartHourDropdown(defaultValue) {
		const startSelect = document.getElementById('modifyModalStartTime');
		startSelect.innerHTML = '';

		// Add all possible start hours (8-21)
		for (let hour = 8; hour <= 21; hour++) {
			const timeStr = `${hour.toString().padStart(2, '0')}:00`;
			const option = document.createElement('option');
			option.value = timeStr;
			option.textContent = timeStr;
			if (timeStr === defaultValue) {
				option.selected = true;
			}
			startSelect.appendChild(option);
		}

		// Populate end time based on selected start time
		if (startSelect.value) {
			const startHour = parseInt(startSelect.value.split(':')[0]);
			const endTimeStr = `${String(startHour + 1).padStart(2, '0')}:00`;
			populateModifyEndHourDropdown(endTimeStr);
		}
	}

	// Populate modify end hour dropdown
	function populateModifyEndHourDropdown(defaultValue) {
		const endSelect = document.getElementById('modifyModalEndTime');
		endSelect.innerHTML = '';

		const startTimeStr = document.getElementById('modifyModalStartTime').value;
		if (!startTimeStr) {
			return;
		}

		const startHour = parseInt(startTimeStr.split(':')[0]);

		// Add only up to 2 options: start+1 and start+2
		let addedCount = 0;
		for (let endHour = startHour + 1; endHour <= startHour + 2 && endHour <= 22 && addedCount < 2; endHour++) {
			const timeStr = `${endHour.toString().padStart(2, '0')}:00`;
			const option = document.createElement('option');
			option.value = timeStr;
			option.textContent = timeStr;
			if (timeStr === defaultValue || addedCount === 0) {
				option.selected = true;
			}
			endSelect.appendChild(option);
			addedCount++;
		}
	}

	// Handle modify start time change
	document.getElementById('modifyModalStartTime').addEventListener('change', function() {
		const selectedStartTime = this.value;
		if (selectedStartTime) {
			const startHour = parseInt(selectedStartTime.split(':')[0]);
			const endTimeStr = `${String(startHour + 1).padStart(2, '0')}:00`;
			populateModifyEndHourDropdown(endTimeStr);
			document.getElementById('modifyModalEndTime').value = endTimeStr;
		}
	});

	// Handle modify booking form submission
	document.getElementById('submitModifyBookingBtn').addEventListener('click', async function() {
		const bookingId = document.getElementById('modifyModalBookingId').value;
		const bookingDate = globalModifyBookingData.bookingDate; // Use stored booking date
		const startTime = document.getElementById('modifyModalStartTime').value;
		const endTime = document.getElementById('modifyModalEndTime').value;
		const notes = null;

		// Validate times
		if (!startTime || !endTime) {
			document.getElementById('modifyModalTimeValidationError').textContent = 'Please select both start and end times.';
			document.getElementById('modifyModalTimeValidationError').style.display = 'block';
			return;
		}

		const startHour = parseInt(startTime.split(':')[0]);
		const endHour = parseInt(endTime.split(':')[0]);
		if (startHour >= endHour) {
			document.getElementById('modifyModalTimeValidationError').textContent = 'Start hour must be before end hour.';
			document.getElementById('modifyModalTimeValidationError').style.display = 'block';
			return;
		}

		document.getElementById('modifyModalTimeValidationError').style.display = 'none';

		// Disable submit button during submission
		this.disabled = true;

		try {
			// Get antiforgery token
			const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
			const token = tokenInput ? tokenInput.value : '';

			const params = new URLSearchParams();
			params.append('bookingId', bookingId);
			params.append('bookingDate', bookingDate);
			params.append('startHour', startTime);
			params.append('endHour', endTime);
			params.append('notes', '');
			params.append('__RequestVerificationToken', token);

			const response = await fetch('?handler=ModifyBooking', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/x-www-form-urlencoded',
					'X-Requested-With': 'XMLHttpRequest'
				},
				body: params.toString()
			});

			const data = await response.json();

			if (data.success) {
				// Close modal
				const modifyModal = bootstrap.Modal.getInstance(document.getElementById('modifyBookingModal'));
				modifyModal.hide();

				// Show success message
				showSuccessBanner(globalModifyBookingData.roomName, bookingDate, startTime, endTime, 'Booking Updated');

				// Reload page after short delay to refresh the calendar
				setTimeout(() => {
					location.reload();
				}, 2000);
			} else {
				// Show error message in modal
				document.getElementById('modifyBookingAlert').style.display = 'block';
				document.getElementById('modifyBookingErrors').innerHTML = `<div>${data.error}</div>`;
				this.disabled = false;
			}
		} catch (error) {
			console.error('Error:', error);
			document.getElementById('modifyBookingAlert').style.display = 'block';
			document.getElementById('modifyBookingErrors').innerHTML = `<div>${error.message}</div>`;
			this.disabled = false;
		}
	});

	// Handle delete booking button
	document.getElementById('deleteModifyBookingBtn').addEventListener('click', async function() {
		const bookingId = document.getElementById('modifyModalBookingId').value;
		this.disabled = true;

		try {
			// Get antiforgery token
			const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
			const token = tokenInput ? tokenInput.value : '';

			const params = new URLSearchParams();
			params.append('bookingId', bookingId);
			params.append('__RequestVerificationToken', token);

			const response = await fetch('?handler=DeleteBooking', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/x-www-form-urlencoded',
					'X-Requested-With': 'XMLHttpRequest'
				},
				body: params.toString()
			});

			const data = await response.json();

			if (data.success) {
				// Close modal
				const modifyModal = bootstrap.Modal.getInstance(document.getElementById('modifyBookingModal'));
				modifyModal.hide();

				// Show success message
				const banner = document.createElement('div');
				banner.className = 'alert alert-success alert-dismissible fade show';
				banner.style.position = 'fixed';
				banner.style.top = '20px';
				banner.style.right = '20px';
				banner.style.zIndex = '9999';
				banner.style.minWidth = '300px';
				banner.innerHTML = `
					<strong>Booking Deleted!</strong>
					<div style="margin-top: 8px; font-size: 0.9rem;">
						<div>Your booking has been cancelled successfully.</div>
					</div>
					<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
				`;
				document.body.appendChild(banner);

				// Auto-dismiss after 5 seconds
				setTimeout(() => {
						banner.remove();
					}, 5000);

					// Reload page immediately to refresh the calendar
					location.reload();
			} else {
				// Show error message in modal
				document.getElementById('modifyBookingAlert').style.display = 'block';
				document.getElementById('modifyBookingErrors').innerHTML = `<div>${data.error}</div>`;
				this.disabled = false;
			}
		} catch (error) {
			console.error('Error:', error);
			document.getElementById('modifyBookingAlert').style.display = 'block';
			document.getElementById('modifyBookingErrors').innerHTML = `<div>${error.message}</div>`;
			this.disabled = false;
		}
	});
});
</script>
