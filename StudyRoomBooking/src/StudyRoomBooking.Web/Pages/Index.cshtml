@page
@model IndexModel
@{
	ViewData["Title"] = "Book a Room";
	var minDate = DateTime.Today.ToString("yyyy-MM-dd");
	var maxDate = DateTime.Today.AddDays(60).ToString("yyyy-MM-dd");
}

<style>
	.time-validation-error {
		display: none;
		color: #dc3545;
		font-size: 0.875rem;
		margin-top: 0.25rem;
	}
	.time-validation-error.show {
		display: block;
	}
</style>

<div class="container mt-4">
	<h2>Book a Room</h2>

	@if (!ViewData.ModelState.IsValid)
	{
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			<strong>Booking Search Error</strong>
			<ul class="mb-0">
				@foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
				{
					<li>@error.ErrorMessage</li>
				}
			</ul>
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	<form method="post" class="card p-4 mb-4">
		<div class="row">
			<div class="col-md-3">
				<div class="form-group">
					<label for="bookingDate" class="form-label">Date *</label>
					<div class="input-group">
						<button type="button" id="dateBackBtn" class="btn btn-outline-secondary" title="Previous day">
							<i class="bi bi-chevron-down"></i> ◀
						</button>
						<input type="date" id="bookingDate" name="searchCriteria.BookingDate" 
							   min="@minDate" max="@maxDate"
							   value="@Model.SearchCriteria.BookingDate.ToString("yyyy-MM-dd")" class="form-control" required />
						<button type="button" id="dateForwardBtn" class="btn btn-outline-secondary" title="Next day">
							▶ <i class="bi bi-chevron-up"></i>
						</button>
					</div>
					<small class="text-muted">Today to 60 days ahead</small>
					<div id="dateWarning" class="alert alert-warning mt-2" style="display: none; padding: 0.5rem 0.75rem; margin: 0.5rem 0;">
						Cannot go to past date. Today is selected.
					</div>
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-group">
					<label for="startTime" class="form-label">Start Hour</label>
					<select id="startTime" name="searchCriteria.StartTime" class="form-select">
						<option value="" selected="@(!Model.SearchCriteria.StartTime.HasValue)">--:--</option>
						@for (int hour = 8; hour <= 21; hour++)
						{
							<option value="@hour:00" selected="@(Model.SearchCriteria.StartTime.HasValue && Model.SearchCriteria.StartTime.Value.Hours == hour)">@hour:00</option>
						}
					</select>
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-group">
					<label for="endTime" class="form-label">End Hour</label>
					<select id="endTime" name="searchCriteria.EndTime" class="form-select">
						<option value="" selected="@(!Model.SearchCriteria.EndTime.HasValue)">--:--</option>
						@for (int hour = 9; hour <= 22; hour++)
						{
							<option value="@hour:00" selected="@(Model.SearchCriteria.EndTime.HasValue && Model.SearchCriteria.EndTime.Value.Hours == hour)">@hour:00</option>
						}
					</select>
					<div id="timeValidationError" class="time-validation-error">Start hour must be before end hour.</div>
				</div>
			</div>
		</div>

		<div class="row">
				@if (Model.CurrentUserRole == "Staff" || Model.CurrentUserRole == "Student")
				{
					<div class="col-md-4">
						<div class="form-group">
							<label for="roomType" class="form-label">Room Type</label>
							<select id="roomType" name="searchCriteria.RoomType" class="form-select">
								<option value="">Any</option>
								@foreach (var type in Model.AvailableRoomTypes)
								{
									<option value="@type" selected="@(Model.SearchCriteria.RoomType == type)">@type.ToDisplayName()</option>
								}
							</select>
						</div>
					</div>
				}
			<div class="col-md-4">
				<div class="form-group">
					<label for="location" class="form-label">Location</label>
					<input type="text" id="location" name="searchCriteria.Location" 
						   value="@Model.SearchCriteria.Location" placeholder="e.g., Building A" class="form-control" />
				</div>
			</div>
			<div class="col-md-4">
				<div class="form-group search-action">
					<button type="submit" class="btn btn-primary btn-search form-control">Find Available Rooms</button>
				</div>
			</div>
		</div>
	</form>

	@if (Model.SearchResults.Any())
	{
		<div class="card mt-4">
			<div class="card-header">
				<div style="display: flex; justify-content: space-between; align-items: flex-start;">
					<div>
						<h5 class="mb-0">Available Rooms for @Model.SearchCriteria.BookingDate.ToString("dddd, MMMM dd, yyyy")</h5>
						<small class="text-muted">Time Range: 08:00 - 22:00</small>
					</div>
					<div style="display: flex; gap: 15px; font-size: 0.9rem;">
						<div style="display: flex; align-items: center; gap: 5px;">
							<span style="display: inline-block; width: 20px; height: 20px; background-color: var(--success); border-radius: 3px;"></span>
							<span>Available</span>
						</div>
						<div style="display: flex; align-items: center; gap: 5px;">
							<span style="display: inline-block; width: 20px; height: 20px; background-color: var(--delete); border-radius: 3px;"></span>
							<span>Booked</span>
						</div>
						<div style="display: flex; align-items: center; gap: 5px;">
							<span style="display: inline-block; width: 20px; height: 20px; background-color: #2563EB; border-radius: 3px;"></span>
							<span>Your Booking</span>
						</div>
						<div style="display: flex; align-items: center; gap: 5px;">
							<span style="display: inline-block; width: 20px; height: 20px; background-color: #9CA3AF; border-radius: 3px;"></span>
							<span>Unavailable</span>
						</div>
					</div>
				</div>
			</div>
			<div class="card-body">
				<div class="table-responsive">
					<table class="table table-bordered text-center">
						<thead>
							<tr class="table-light">
								<th style="width: 120px;">Room Details</th>
								@{
									var startTime = new TimeSpan(8, 0, 0);  // Always start from 8:00
									var endTime = new TimeSpan(22, 0, 0);  // Always end at 22:00
									var interval = TimeSpan.FromHours(1);
									var currentTime = startTime;
									var timeSlots = new List<TimeSpan>();

									while (currentTime < endTime)
									{
										timeSlots.Add(currentTime);
										currentTime = currentTime.Add(interval);
									}
								}
								@foreach (var timeSlot in timeSlots)
								{
									<th>@timeSlot.ToString(@"hh\:mm")</th>
								}
								</tr>
						</thead>
						<tbody>
							@foreach (var room in Model.SearchResults)
							{
								<tr>
									<td class="text-start" style="vertical-align: middle;">
										<div>
											<strong>@room.Name</strong><br />
											<small class="text-muted">@room.Code<br />@room.Location<br />Cap: @room.Capacity</small>
										</div>
									</td>
									@{
										var bookingsForRoom = await Model.GetRoomBookingsAsync(room.Id, Model.SearchCriteria.BookingDate);
									}
									@foreach (var timeSlot in timeSlots)
									{
										var nextTime = timeSlot.Add(interval);
										var bookedSlot = bookingsForRoom.FirstOrDefault(b => 
											!(b.EndTime <= timeSlot || b.StartTime >= nextTime) && 
											b.Status != StudyRoomBooking.Domain.Enums.BookingStatus.Cancelled);
										var isBooked = bookedSlot != null;
										var isOwnBooking = isBooked && bookedSlot.UserId == Model.CurrentUserId;
										var isInSearchRange = Model.IsTimeSlotInSearchRange(timeSlot);
										var isInPast = Model.IsTimeSlotInPast(timeSlot);
										var startHour = timeSlot.Hours;
										var endHour = nextTime.Hours;

										<td style="padding: 4px;">
											@if (isInSearchRange && !isInPast)
											{
												@if (isBooked)
												{
													@if (isOwnBooking)
													{
														<a asp-page="/Students/ModifyBooking" asp-route-id="@bookedSlot.Id" class="badge calendar-slot calendar-slot-booked-self" style="text-decoration: none; cursor: pointer;"></a>
													}
													else
													{
														<span class="badge calendar-slot calendar-slot-booked"></span>
													}
												}
												else
												{
													<a asp-page="/Students/RoomDetails" asp-route-id="@room.Id" asp-route-bookingDate="@Model.SearchCriteria.BookingDate.ToString("yyyy-MM-dd")" asp-route-startTime="@startHour:00" asp-route-endTime="@endHour:00" class="badge calendar-slot calendar-slot-free"> </a>
												}
											}
											else
											{
												<span class="badge calendar-slot calendar-slot-unavailable"> </span>
											}
										</td>
												}
											</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>

		<style>
			.room-matrix table {
				font-size: 0.9rem;
			}
			.room-matrix .badge {
				font-size: 0.75rem;
				padding: 4px 8px;
			}
			.room-matrix th {
				background-color: #f8f9fa;
				padding: 8px 4px;
				font-size: 0.85rem;
			}
			.room-matrix td {
				padding: 8px 4px;
				height: auto;
			}
		</style>
	}
	else if (Model.HasSearched)
	{
		<div class="alert alert-info">No available rooms found for the selected criteria.</div>
	}
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
	const startTimeSelect = document.getElementById('startTime');
	const endTimeSelect = document.getElementById('endTime');
	const searchButton = document.querySelector('form button[type="submit"]');
	const timeValidationError = document.getElementById('timeValidationError');

	function validateTimeRange() {
		if (startTimeSelect.value && endTimeSelect.value) {
			const startHour = parseInt(startTimeSelect.value.split(':')[0]);
			const endHour = parseInt(endTimeSelect.value.split(':')[0]);

			if (startHour >= endHour) {
				timeValidationError.classList.add('show');
				searchButton.disabled = true;
				return false;
			} else {
				timeValidationError.classList.remove('show');
				searchButton.disabled = false;
				return true;
			}
		} else {
			timeValidationError.classList.remove('show');
			searchButton.disabled = false;
			return true;
		}
	}

	// Add event listeners to both time selects
	startTimeSelect.addEventListener('change', validateTimeRange);
	endTimeSelect.addEventListener('change', validateTimeRange);

	// Date navigation buttons
	const bookingDateInput = document.getElementById('bookingDate');
	const dateBackBtn = document.getElementById('dateBackBtn');
	const dateForwardBtn = document.getElementById('dateForwardBtn');
	const dateWarning = document.getElementById('dateWarning');
	const todayStr = new Date().toISOString().split('T')[0];

	function updateDateButtons() {
		const currentDate = bookingDateInput.value;
		const minDate = bookingDateInput.getAttribute('min');
		const maxDate = bookingDateInput.getAttribute('max');

		// Disable backward button if at minimum date
		dateBackBtn.disabled = currentDate === minDate;
		// Disable forward button if at maximum date
		dateForwardBtn.disabled = currentDate === maxDate;
	}

	dateBackBtn.addEventListener('click', function(e) {
		e.preventDefault();
		const currentDate = new Date(bookingDateInput.value);
		const previousDate = new Date(currentDate);
		previousDate.setDate(previousDate.getDate() - 1);

		const previousDateStr = previousDate.toISOString().split('T')[0];
		const minDate = bookingDateInput.getAttribute('min');

		if (previousDateStr < minDate) {
			// Show warning and don't change the date
			dateWarning.textContent = 'Cannot go to past date. ' + new Date(minDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) + ' is selected.';
			dateWarning.style.display = 'block';
			setTimeout(() => {
				dateWarning.style.display = 'none';
			}, 3000);
		} else {
			bookingDateInput.value = previousDateStr;
			dateWarning.style.display = 'none';
			updateDateButtons();
		}
	});

	dateForwardBtn.addEventListener('click', function(e) {
		e.preventDefault();
		const currentDate = new Date(bookingDateInput.value);
		const nextDate = new Date(currentDate);
		nextDate.setDate(nextDate.getDate() + 1);

		const nextDateStr = nextDate.toISOString().split('T')[0];
		const maxDate = bookingDateInput.getAttribute('max');

		if (nextDateStr > maxDate) {
			// Disable forward navigation if at max date
			return;
		} else {
			bookingDateInput.value = nextDateStr;
			dateWarning.style.display = 'none';
			updateDateButtons();
		}
	});

	// Update button states when date input changes (calendar selection)
	bookingDateInput.addEventListener('change', function() {
		updateDateButtons();
	});

	// Initial button state
	updateDateButtons();

	// Validate on form submission
	document.querySelector('form').addEventListener('submit', function(e) {
		if (!validateTimeRange()) {
			e.preventDefault();
		}
	});

	// Initial validation in case values are pre-filled
	validateTimeRange();
});
</script>
