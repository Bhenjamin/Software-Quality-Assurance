							<div style="white-space: nowrap; font-size: 0.9rem;"><strong>Start:</strong> <span id="modifyRecurringModalStartDateDisplay"></span></div>
							<div style="white-space: nowrap; font-size: 0.9rem;"><strong>End:</strong> <span id="modifyRecurringModalRecurrenceEndDateDisplay"></span></div>
							<div style="white-space: nowrap; font-size: 0.9rem;"><strong>Recurrence Pattern:</strong> <span id="modifyRecurringModalRecurrencePatternDisplay"></span></div>
						</div>
						<div class="mb-0 d-flex align-items-center gap-2" style="white-space: nowrap;">
