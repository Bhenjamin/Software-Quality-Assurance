@page
@model RecurringBookingModel
@{
	ViewData["Title"] = "Search Recurring Bookings";
	var minDate = DateTime.Today.ToString("yyyy-MM-dd");
	var maxDate = DateTime.Today.AddDays(180).ToString("yyyy-MM-dd");
}

<style>
	.time-validation-error {
		display: none;
		color: #dc3545;
		font-size: 0.875rem;
		margin-top: 0.25rem;
	}
	.time-validation-error.show {
		display: block;
	}
	.booking-modal-dialog {
		max-width: 450px;
		width: 90%;
	}
</style>

<div class="container mt-4">
	@if (!ViewData.ModelState.IsValid)
	{
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			<strong>Search Error!</strong>
			<ul class="mb-0">
				@foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
				{
					<li>@error.ErrorMessage</li>
				}
			</ul>
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	<form method="post" class="card p-3 mb-3">
		<div class="d-flex align-items-end gap-4">
			<div style="width: 22%;">
				<div class="form-group">
					<label for="startDate" class="form-label">Start Date <small class="text-muted"> - Limit: 6 months</small></label>
					<div class="input-group">
						<button type="button" id="startDateBackBtn" class="btn btn-outline-secondary" title="Previous day">
							<i class="bi bi-chevron-down"></i> ◀
						</button>
						<input type="date" id="startDate" name="searchCriteria.StartDate" 
							   min="@minDate" max="@maxDate"
							   value="@Model.SearchCriteria.StartDate.ToString("yyyy-MM-dd")" class="form-control" required />
						<button type="button" id="startDateForwardBtn" class="btn btn-outline-secondary" title="Next day">
							▶ <i class="bi bi-chevron-up"></i>
						</button>
					</div>
					
					<div id="startDateWarning" class="alert alert-warning mt-2" style="display: none; padding: 0.5rem 0.75rem; margin: 0.5rem 0;">
						Cannot go to past date. Today is selected.
					</div>
				</div>
			</div>
			<div style="width: 22%;">
				<div class="form-group">
					<label for="recurrenceEndDate" class="form-label">Recurrence End Date</label>
					<div class="input-group">
						<button type="button" id="endDateBackBtn" class="btn btn-outline-secondary" title="Previous day">
							<i class="bi bi-chevron-down"></i> ◀
						</button>
						<input type="date" id="recurrenceEndDate" name="searchCriteria.RecurrenceEndDate" 
							   min="@minDate" max="@maxDate"
							   value="@Model.SearchCriteria.RecurrenceEndDate.ToString("yyyy-MM-dd")" class="form-control" required />
						<button type="button" id="endDateForwardBtn" class="btn btn-outline-secondary" title="Next day">
							▶ <i class="bi bi-chevron-up"></i>
						</button>
					</div>
					<div id="endDateWarning" class="alert alert-warning mt-2" style="display: none; padding: 0.5rem 0.75rem; margin: 0.5rem 0;">
						Cannot go to past date. Today is selected.
					</div>
				</div>
			</div>
		@* 	<div class="col-md-3">
				<div class="form-group">
					<label for="startTime" class="form-label">Start Hour</label>
					<select id="startTime" name="searchCriteria.StartTime" class="form-select">
						<option value="" selected="@(!Model.SearchCriteria.StartTime.HasValue)">--:--</option>
						@for (int hour = 8; hour <= 21; hour++)
						{
							<option value="@hour:00" selected="@(Model.SearchCriteria.StartTime.HasValue && Model.SearchCriteria.StartTime.Value.Hours == hour)">@hour:00</option>
						}
					</select>
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-group">
					<label for="endTime" class="form-label">End Hour</label>
					<select id="endTime" name="searchCriteria.EndTime" class="form-select">
						<option value="" selected="@(!Model.SearchCriteria.EndTime.HasValue)">--:--</option>
						@for (int hour = 9; hour <= 22; hour++)
						{
							<option value="@hour:00" selected="@(Model.SearchCriteria.EndTime.HasValue && Model.SearchCriteria.EndTime.Value.Hours == hour)">@hour:00</option>
						}
					</select>
					<div id="timeValidationError" class="time-validation-error">Start hour must be before end hour.</div>
				</div>
			</div>
		</div>

		<div class="row"> *@
			<div style="width: 25%;">
				<div class="form-group">
					<label for="roomType" class="form-label">Room Type</label>
					<select id="roomType" name="searchCriteria.RoomType" class="form-select">
						<option value="">Any</option>
						@foreach (var type in Enum.GetValues(typeof(StudyRoomBooking.Domain.Enums.RoomType)))
						{
							var roomType = (StudyRoomBooking.Domain.Enums.RoomType)type;
							<option value="@type" selected="@(Model.SearchCriteria.RoomType == roomType)">@roomType.ToDisplayName()</option>
						}
					</select>
				</div>
			</div>
			<div style="width: 13%;">
				<div class="form-group">
					<label for="location" class="form-label">Location</label>
					<select id="location" name="searchCriteria.Location" class="form-select">
						<option value="">Any</option>
						@foreach (var building in Model.AvailableBuildings)
						{
							<option value="Building @building" selected="@(Model.SearchCriteria.Location == "Building " + building.ToString())">Building @building</option>
						}
					</select>
				</div>
			</div>
			<div style="width: 18%;">
				<div class="form-group">
					<label for="recurrencePattern" class="form-label">Recurrence Pattern</label>
					<select id="recurrencePattern" name="searchCriteria.RecurrencePattern" class="form-select">
						@foreach (var pattern in Enum.GetValues(typeof(StudyRoomBooking.Domain.Enums.RecurrencePattern)))
						{
							var recurrencePattern = (StudyRoomBooking.Domain.Enums.RecurrencePattern)pattern;
							<option value="@pattern"
									selected="@(Model.SearchCriteria.RecurrencePattern == recurrencePattern)">
								@(recurrencePattern == StudyRoomBooking.Domain.Enums.RecurrencePattern.FourWeeks ? "Four Weeks" : recurrencePattern.ToString())
							</option>
						}
					</select>
				</div>
			</div>
		</div>
	</form>

	@if (Model.SearchResults.Any())
	{
		<div class="card mt-4">
			<div class="card-header">
				<div style="display: flex; justify-content: flex-start; align-items: flex-start; gap: 15px;">
					<div style="width: 55%;">
						<h5 class="mb-0">Available Rooms for @Model.SearchCriteria.StartDate.ToString("dddd, MMMM dd, yyyy")</h5>
						<small class="text-muted">Recurring from @Model.SearchCriteria.StartDate.ToString("MMM dd") to @Model.SearchCriteria.RecurrenceEndDate.ToString("MMM dd, yyyy") | Time Range: 08:00 - 22:00
							@if (Model.SearchCriteria.StartTime.HasValue || Model.SearchCriteria.EndTime.HasValue)
							{
								<br /><strong style="color: #0c63e4;">✓ Filtered: Showing only rooms available at specified hours across the entire date range</strong>
							}
						</small>
					</div>
					<div style="width: 45%; display: grid; grid-template-columns: 2fr 1fr; gap: 10px; font-size: 0.9rem;">
						<div style="display: flex; align-items: flex-start; gap: 10px;">
							<span style="display: inline-block; width: 20px; height: 20px; background-color: var(--success); border-radius: 3px; flex-shrink: 0; margin-top: 2px;"></span>
							<div style="font-weight: 600;">Available - Click to book</div>
						</div>
						<div style="display: flex; align-items: flex-start; gap: 10px;">
							<span style="display: inline-block; width: 20px; height: 20px; background-color: var(--delete); border-radius: 3px; flex-shrink: 0; margin-top: 2px;"></span>
							<div style="font-weight: 600;">Booked</div>
						</div>
						<div style="display: flex; align-items: flex-start; gap: 10px;">
							<span style="display: inline-block; width: 20px; height: 20px; background-color: #2563EB; border-radius: 3px; flex-shrink: 0; margin-top: 2px;"></span>
							<div style="font-weight: 600;">Your Booking - Click to view/modify</div>
						</div>
						<div style="display: flex; align-items: flex-start; gap: 10px;">
							<span style="display: inline-block; width: 20px; height: 20px; background-color: #9CA3AF; border-radius: 3px; flex-shrink: 0; margin-top: 2px;"></span>
							<div style="font-weight: 600;">Unavailable</div>
						</div>
					</div>
				</div>
			</div>
			<div class="card-body">
				<div class="table-responsive">
					<table class="table table-bordered text-center">
						<thead>
							<tr class="table-light">
								<th style="width: 120px;">Room Details</th>
								@{
									var startTime = new TimeSpan(8, 0, 0);  // Always start from 8:00
									var endTime = new TimeSpan(22, 0, 0);  // Always end at 22:00
									var interval = TimeSpan.FromHours(1);
									var currentTime = startTime;
									var timeSlots = new List<TimeSpan>();

									while (currentTime < endTime)
									{
										timeSlots.Add(currentTime);
										currentTime = currentTime.Add(interval);
									}
								}
								@foreach (var timeSlot in timeSlots)
								{
									<th>@timeSlot.ToString(@"hh\:mm")</th>
								}
								</tr>
						</thead>
						<tbody>
							@foreach (var room in Model.SearchResults)
							{

								<tr>
									<td class="text-start" style="vertical-align: middle;">
										<div>
											<strong>@room.Name</strong><br />
											<small class="text-muted">@room.Code<br />@room.Location<br />Cap: @room.Capacity</small>
										</div>
									</td>
									@foreach (var timeSlot in timeSlots)
									{
										var nextTime = timeSlot.Add(interval);
										var startHour = timeSlot.Hours;
										var endHour = nextTime.Hours;

										// Get the pre-calculated slot status from the cache
										var slotStatus = Model.SlotStatusCache.ContainsKey(room.Id) && Model.SlotStatusCache[room.Id].ContainsKey(timeSlot)
											? Model.SlotStatusCache[room.Id][timeSlot]
											: SlotStatus.Unavailable;

										// Check if slot is in the past (only when StartDate is today)
										var isInPast = Model.IsTimeSlotInPast(timeSlot);

										<td style="padding: 4px;">
											@if (!isInPast && slotStatus == SlotStatus.Available)
											{
												<!--Green: Available - clickable button -->
												<button type="button" class="badge calendar-slot calendar-slot-free btn-recurring-book" 
													data-room-id="@room.Id"
													data-start-date="@Model.SearchCriteria.StartDate.ToString("yyyy-MM-dd")"
													data-start-time="@(startHour.ToString().PadLeft(2,'0')):00"
													data-end-time="@(endHour.ToString().PadLeft(2,'0')):00"
													data-recurrence-end-date="@Model.SearchCriteria.RecurrenceEndDate.ToString("yyyy-MM-dd")"
													data-recurrence-pattern="@Model.SearchCriteria.RecurrencePattern"
													data-room-name="@room.Name"
													data-room-code="@room.Code"
													data-room-location="@room.Location"
													data-room-capacity="@room.Capacity"
													style="border: none; background: none; padding: 0; cursor: pointer;"> </button>
											}
											else if (!isInPast && slotStatus == SlotStatus.YourBooking)
											{
												<!-- Blue: Your booking - clickable badge to modify -->
												<span class="badge calendar-slot calendar-slot-booked-self" 
													style="cursor: pointer;"
													data-room-id="@room.Id"
													data-start-date="@Model.SearchCriteria.StartDate.ToString("yyyy-MM-dd")"
													data-start-time="@(startHour.ToString().PadLeft(2,'0')):00"
													data-end-time="@(endHour.ToString().PadLeft(2,'0')):00"
													data-recurrence-end-date="@Model.SearchCriteria.RecurrenceEndDate.ToString("yyyy-MM-dd")"
													data-recurrence-pattern="@Model.SearchCriteria.RecurrencePattern"
													data-room-name="@room.Name"
													data-room-code="@room.Code"
													data-room-location="@room.Location"
													data-room-capacity="@room.Capacity"></span>
											}
											else if (!isInPast && (slotStatus == SlotStatus.Booked || slotStatus == SlotStatus.Mixed))
											{
												<!-- Red or Mixed: Booked or Mixed booking -->
												@if (slotStatus == SlotStatus.Mixed)
												{
													<!-- Red + Blue: Mixed booking -->
													<span class="badge calendar-slot calendar-slot-booked" style="position: relative; background: linear-gradient(135deg, #dc3545 50%, #2563EB 50%);"> </span>
												}
												else
												{
													<!-- Red: Booked -->
													<span class="badge calendar-slot calendar-slot-booked"> </span>
												}
											}
											else
											{
												<!-- Grey: Unavailable (past or placeholder) -->
												<span class="badge calendar-slot calendar-slot-unavailable"> </span>
											}
										</td>
									}
									</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>

		<div class="mt-4 mb-4">
			<a href="@Url.Page("/Staff/RecurringBooking")" class="btn btn-secondary">Clear Search</a>
		</div>
	}
	else if (Model.HasSearched)
	{
		<div class="alert alert-info">
			No rooms found matching your search criteria. Please try adjusting your filters.
		</div>
	}
</div>

<script>
	document.addEventListener('DOMContentLoaded', function () {
		// const startTimeSelect = document.getElementById('startTime');
		// const endTimeSelect = document.getElementById('endTime');
		// const timeValidationError = document.getElementById('timeValidationError');

		// function validateTimes() {
		// 	const startTime = startTimeSelect.value;
		// 	const endTime = endTimeSelect.value;

		// 	if (startTime && endTime) {
		// 		const startHour = parseInt(startTime.split(':')[0]);
		// 		const endHour = parseInt(endTime.split(':')[0]);

		// 		if (startHour >= endHour) {
		// 			timeValidationError.classList.add('show');
		// 		} else {
		// 			timeValidationError.classList.remove('show');
		// 		}
		// 	} else {
		// 		timeValidationError.classList.remove('show');
		// 	}
		// }

		// startTimeSelect.addEventListener('change', function() {
		// 	validateTimes();
		// 	autoSubmitSearch();
		// });
		// endTimeSelect.addEventListener('change', function() {
		// 	validateTimes();
		// 	autoSubmitSearch();
		// });

		// Date navigation buttons for Start Date
		const startDateInput = document.getElementById('startDate');
		const startDateBackBtn = document.getElementById('startDateBackBtn');
		const startDateForwardBtn = document.getElementById('startDateForwardBtn');
		const startDateWarning = document.getElementById('startDateWarning');

		function updateStartDateButtons() {
			const currentDate = startDateInput.value;
			const minDate = startDateInput.getAttribute('min');
			const maxDate = startDateInput.getAttribute('max');
			startDateBackBtn.disabled = currentDate === minDate;
			startDateForwardBtn.disabled = currentDate === maxDate;
		}

		startDateBackBtn.addEventListener('click', function(e) {
			e.preventDefault();
			const currentDate = startDateInput.value;
			const minDate = startDateInput.getAttribute('min');

			// Convert yyyy-MM-dd safely
			const [year, month, day] = currentDate.split('-').map(Number);
			const previousDate = new Date(year, month - 1, day);
			previousDate.setDate(previousDate.getDate() - 1);

			const previousDateStr =
				previousDate.getFullYear() + '-' +
				String(previousDate.getMonth() + 1).padStart(2, '0') + '-' +
				String(previousDate.getDate()).padStart(2, '0');

			if (previousDateStr < minDate) {
				startDateWarning.textContent = 'Cannot go to past date. ' + new Date(minDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) + ' is selected.';
				startDateWarning.style.display = 'block';
				setTimeout(() => { startDateWarning.style.display = 'none'; }, 3000);
				} else {
					startDateInput.value = previousDateStr;
					startDateWarning.style.display = 'none';
					updateStartDateButtons();
					autoSubmitSearch();
				}
			});

			startDateForwardBtn.addEventListener('click', function(e) {
				e.preventDefault();
				const currentDate = startDateInput.value;
				const maxDate = startDateInput.getAttribute('max');

				// Convert yyyy-MM-dd safely
				const [year, month, day] = currentDate.split('-').map(Number);
				const nextDate = new Date(year, month - 1, day);
				nextDate.setDate(nextDate.getDate() + 1);

				const nextDateStr =
					nextDate.getFullYear() + '-' +
					String(nextDate.getMonth() + 1).padStart(2, '0') + '-' +
					String(nextDate.getDate()).padStart(2, '0');

				if (nextDateStr > maxDate) return;
				startDateInput.value = nextDateStr;
				startDateWarning.style.display = 'none';
				updateStartDateButtons();
				autoSubmitSearch();
			});

			// Update button states when date input changes (calendar selection)
			startDateInput.addEventListener('change', function() {
				updateStartDateButtons();
				autoSubmitSearch();
		});

		updateStartDateButtons();

		// Date navigation buttons for End Date
		const endDateInput = document.getElementById('recurrenceEndDate');
		const endDateBackBtn = document.getElementById('endDateBackBtn');
		const endDateForwardBtn = document.getElementById('endDateForwardBtn');
		const endDateWarning = document.getElementById('endDateWarning');

		function updateEndDateButtons() {
			const currentDate = endDateInput.value;
			const minDate = endDateInput.getAttribute('min');
			endDateBackBtn.disabled = currentDate === minDate;
		}

		endDateBackBtn.addEventListener('click', function(e) {
			e.preventDefault();
			const currentDate = endDateInput.value;
			const minDate = endDateInput.getAttribute('min');

			// Convert yyyy-MM-dd safely
			const [year, month, day] = currentDate.split('-').map(Number);
			const previousDate = new Date(year, month - 1, day);
			previousDate.setDate(previousDate.getDate() - 1);

			const previousDateStr =
				previousDate.getFullYear() + '-' +
				String(previousDate.getMonth() + 1).padStart(2, '0') + '-' +
				String(previousDate.getDate()).padStart(2, '0');

			if (previousDateStr < minDate) {
				endDateWarning.textContent = 'Cannot go to past date. ' + new Date(minDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) + ' is selected.';
				endDateWarning.style.display = 'block';
				setTimeout(() => { endDateWarning.style.display = 'none'; }, 3000);
				} else {
					endDateInput.value = previousDateStr;
					endDateWarning.style.display = 'none';
					updateEndDateButtons();
					autoSubmitSearch();
				}
			});

			endDateForwardBtn.addEventListener('click', function(e) {
				e.preventDefault();
				const currentDate = endDateInput.value;

				// Convert yyyy-MM-dd safely
				const [year, month, day] = currentDate.split('-').map(Number);
				const nextDate = new Date(year, month - 1, day);
				nextDate.setDate(nextDate.getDate() + 1);

				const nextDateStr =
					nextDate.getFullYear() + '-' +
					String(nextDate.getMonth() + 1).padStart(2, '0') + '-' +
					String(nextDate.getDate()).padStart(2, '0');

				endDateInput.value = nextDateStr;
				endDateWarning.style.display = 'none';
				updateEndDateButtons();
				autoSubmitSearch();
			});

		// Update button states when date input changes (calendar selection)
		endDateInput.addEventListener('change', function() {
			updateEndDateButtons();
			autoSubmitSearch();
		});

		updateEndDateButtons();

		// Validate on page load
		// validateTimes(); // Commented out - no time filters on this page

		// Auto-submit form when any search input changes
		function autoSubmitSearch() {
			const form = document.querySelector('form');
			if (form) {
				form.submit();
			}
		}

		// Add event listeners to all search inputs to auto-submit
		const searchForm = document.querySelector('form');
		if (searchForm) {
			// Start date input
			startDateInput.addEventListener('change', autoSubmitSearch);

			// End date input
			endDateInput.addEventListener('change', autoSubmitSearch);

			// Time inputs
			// const startTimeInput = document.getElementById('startTime');
			// const endTimeInput = document.getElementById('endTime');
			// if (startTimeInput) startTimeInput.addEventListener('change', autoSubmitSearch);
			// if (endTimeInput) endTimeInput.addEventListener('change', autoSubmitSearch);

			// Room type input
			const roomTypeInput = document.getElementById('roomType');
			if (roomTypeInput) roomTypeInput.addEventListener('change', autoSubmitSearch);

			// Location input (dropdown)
			const locationInput = document.getElementById('location');
			if (locationInput) locationInput.addEventListener('change', autoSubmitSearch);

			// Recurrence Pattern input (dropdown)
			const recurrencePatternInput = document.getElementById('recurrencePattern');
			if (recurrencePatternInput) recurrencePatternInput.addEventListener('change', autoSubmitSearch);
		}
	});

	// Add event listener to all recurring booking buttons
	document.addEventListener('DOMContentLoaded', function() {
		const recurringBookingButtons = document.querySelectorAll('.btn-recurring-book');
		recurringBookingButtons.forEach(button => {
			button.addEventListener('click', function(e) {
				e.preventDefault();
				const roomId = parseInt(this.getAttribute('data-room-id'));
				const startDate = this.getAttribute('data-start-date');
				const startTime = this.getAttribute('data-start-time');
				const endTime = this.getAttribute('data-end-time');
				const recurrenceEndDate = this.getAttribute('data-recurrence-end-date');
				const recurrencePattern = this.getAttribute('data-recurrence-pattern');
				const roomName = this.getAttribute('data-room-name');
				const roomDetails = {
					Name: this.getAttribute('data-room-name'),
					Code: this.getAttribute('data-room-code'),
					Location: this.getAttribute('data-room-location'),
					Capacity: parseInt(this.getAttribute('data-room-capacity'))
				};

				openRecurringBookingModal(roomId, startDate, startTime, endTime, recurrenceEndDate, recurrencePattern, roomName, roomDetails);
			});
		});
	});

	// Function to open recurring booking modal
	function openRecurringBookingModal(roomId, startDate, startTime, endTime, recurrenceEndDate, recurrencePattern, roomName, roomDetails) {
		// Populate room details
		document.getElementById('recurringModalRoomNameDetail').textContent = roomDetails.Name;
		document.getElementById('recurringModalRoomCode').textContent = roomDetails.Code;
		document.getElementById('recurringModalRoomLocation').textContent = roomDetails.Location;
		document.getElementById('recurringModalRoomCapacity').textContent = roomDetails.Capacity;

		// Format and display Start Date (DD/MM/YYYY format)
		const startDateObj = new Date(startDate + 'T00:00:00');
		const formattedStartDate = startDateObj.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' });
		document.getElementById('recurringModalStartDateDisplay').textContent = formattedStartDate;
		document.getElementById('recurringModalStartDate').value = startDate;

		// Format and display Recurrence End Date (DD/MM/YYYY format)
		const endDateObj = new Date(recurrenceEndDate + 'T00:00:00');
		const formattedEndDate = endDateObj.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' });
		document.getElementById('recurringModalRecurrenceEndDateDisplay').textContent = formattedEndDate;
		document.getElementById('recurringModalRecurrenceEndDate').value = recurrenceEndDate;

		// Display Recurrence Pattern (convert enum to readable text)
		const patternDisplay = {
			'None': 'No Recurrence',
			'Daily': 'Daily',
			'Weekly': 'Weekly',
			'BiWeekly': 'Bi-Weekly',
			'FourWeeks': 'Every 4 Weeks'
		};
		const selectedPattern = recurrencePattern || 'None';

		document.getElementById('recurringModalRecurrencePatternDisplay').textContent = patternDisplay[selectedPattern] || 'Single Booking';

		document.getElementById('recurringModalRecurrencePattern').value = selectedPattern;

		// Set hidden fields
		document.getElementById('recurringModalRoomId').value = roomId;

		// Extract hour from time string (e.g., "09:00" -> 9)
		const startHour = parseInt(startTime.split(':')[0]);
		const endHour = parseInt(endTime.split(':')[0]);

		// Populate time dropdowns with 8-22 hour range
		populateTimeDropdown('recurringModalStartTime', startHour);
		populateTimeDropdown('recurringModalEndTime', endHour);

		// Clear any previous error messages
		document.getElementById('recurringBookingAlert').style.display = 'none';
		document.getElementById('recurringBookingErrors').innerHTML = '';

		// Show modal
		const modal = new bootstrap.Modal(document.getElementById('recurringBookingModal'));
		modal.show();
	}

	// Helper function to populate time dropdowns
	function populateTimeDropdown(elementId, selectedHour) {
		const select = document.getElementById(elementId);
		select.innerHTML = '';
		for (let hour = 8; hour <= 22; hour++) {
			const option = document.createElement('option');
			const timeStr = `${String(hour).padStart(2, '0')}:00`;
			option.value = timeStr;
			option.textContent = timeStr;
			if (hour === selectedHour) {
				option.selected = true;
			}
			select.appendChild(option);
		}
	}

	// Show success banner for recurring booking
	function showRecurringBookingSuccessBanner(roomName, startDate, recurrenceEndDate, recurrencePattern, startTime, endTime, bookingCount) {
		const banner = document.createElement('div');
		banner.className = 'alert alert-success alert-dismissible fade show';
		banner.style.position = 'fixed';
		banner.style.top = '20px';
		banner.style.right = '20px';
		banner.style.zIndex = '9999';
		banner.style.minWidth = '350px';

		// Format dates
		const startDateObj = new Date(startDate + 'T00:00:00');
		const endDateObj = new Date(recurrenceEndDate + 'T00:00:00');

		const formatDate = (date) => {
			const d = String(date.getDate()).padStart(2, '0');
			const m = String(date.getMonth() + 1).padStart(2, '0');
			const y = date.getFullYear();
			return `${d}-${m}-${y}`;
		};

		// Format recurrence pattern (convert PascalCase to Title Case)
		const formatPattern = (pattern) => {
			if (!pattern) return '';
			return pattern.replace(/([A-Z])/g, ' $1').trim();
		};

		const formattedStartDate = formatDate(startDateObj);
		const formattedEndDate = formatDate(endDateObj);
		const formattedPattern = formatPattern(recurrencePattern);

		banner.innerHTML = `
			<strong>✓ Recurring Booking Created!</strong>
			<div style="margin-top: 8px; font-size: 0.9rem;">
				<div>Room: <strong>${roomName}</strong></div>
				<div>Pattern: <strong>${formattedPattern}</strong></div>
				<div>Period: <strong>${formattedStartDate} to ${formattedEndDate}</strong></div>
				<div>Time: <strong>${startTime} - ${endTime}</strong></div>
				<div style="margin-top: 4px;">Bookings Created: <strong>${bookingCount}</strong></div>
			</div>
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		`;

		document.body.appendChild(banner);

		// Auto-dismiss after 5 seconds
		setTimeout(() => {
			banner.remove();
		}, 5000);
	}

	// Handle form submission - wrap in DOMContentLoaded to ensure button exists
	document.addEventListener('DOMContentLoaded', function() {
		document.getElementById('submitRecurringBookingBtn')?.addEventListener('click', async function(e) {
			e.preventDefault();

			const roomId = document.getElementById('recurringModalRoomId').value;
			const startDate = document.getElementById('recurringModalStartDate').value;
			const startTime = document.getElementById('recurringModalStartTime').value;
			const endTime = document.getElementById('recurringModalEndTime').value;
			const recurrencePattern = document.getElementById('recurringModalRecurrencePattern').value;
			const recurrenceEndDate = document.getElementById('recurringModalRecurrenceEndDate').value;
			const notes = document.getElementById('recurringModalNotes').value || '';

			const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

			// Debug logging
			console.log('Form Data:', {
				roomId, startDate, startTime, endTime, recurrencePattern, recurrenceEndDate, notes, token
			});

			// Validation
			if (!roomId || !startDate || !startTime || !endTime || !recurrencePattern || !recurrenceEndDate) {
				document.getElementById('recurringBookingAlert').style.display = 'block';
				document.getElementById('recurringBookingErrors').innerHTML = 'Please fill in all required fields.';
				console.error('Missing required fields:', { roomId, startDate, startTime, endTime, recurrencePattern, recurrenceEndDate });
				return;
			}

			const params = new URLSearchParams();
			params.append('roomId', roomId);
			params.append('startDate', startDate);
			params.append('startTime', startTime);
			params.append('endTime', endTime);
			params.append('recurrencePattern', recurrencePattern);
			params.append('recurrenceEndDate', recurrenceEndDate);
			params.append('notes', notes);
			params.append('__RequestVerificationToken', token);

			console.log('Request body:', params.toString());

			try {
				const response = await fetch('?handler=CreateRecurringBooking', {
					method: 'POST',
					headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
					body: params.toString()
				});

				console.log('Response status:', response.status);
				const data = await response.json();
				console.log('Response data:', data);

				if (data.success) {
					document.getElementById('recurringBookingAlert').style.display = 'none';

					// Close modal
					bootstrap.Modal.getInstance(document.getElementById('recurringBookingModal')).hide();

					// Show success banner instead of alert
					showRecurringBookingSuccessBanner(
						data.roomName, 
						data.startDate, 
						data.recurrenceEndDate, 
						data.recurrencePattern,
						data.startTime, 
						data.endTime,
						data.bookingCount
					);

					// Reload page after banner auto-dismisses (5 seconds)
					setTimeout(() => location.reload(), 5500);
				} else {
					document.getElementById('recurringBookingAlert').style.display = 'block';
					document.getElementById('recurringBookingErrors').innerHTML = data.error || 'An error occurred';
				}
			} catch (error) {
				console.error('Error:', error);
				document.getElementById('recurringBookingAlert').style.display = 'block';
							document.getElementById('recurringBookingErrors').innerHTML = 'Failed to create booking: ' + error.message;
						}
					});
				});

				// ==================== MODIFY RECURRING BOOKING FUNCTIONS ====================

				// Add click handler to blue slots (YourBooking) to open modify modal
				document.addEventListener('click', async function(e) {
					const blueSlot = e.target.closest('.calendar-slot-booked-self');
					if (blueSlot) {
						e.preventDefault();
						e.stopPropagation();

						// Get data attributes directly from the blue slot
						const roomId = blueSlot.getAttribute('data-room-id');
						const startDate = blueSlot.getAttribute('data-start-date');
						const startTime = blueSlot.getAttribute('data-start-time');
						const endTime = blueSlot.getAttribute('data-end-time');
						const recurrenceEndDate = blueSlot.getAttribute('data-recurrence-end-date');
						const recurrencePattern = blueSlot.getAttribute('data-recurrence-pattern');
						const roomDetails = {
							Name: blueSlot.getAttribute('data-room-name'),
							Code: blueSlot.getAttribute('data-room-code'),
							Location: blueSlot.getAttribute('data-room-location'),
							Capacity: parseInt(blueSlot.getAttribute('data-room-capacity'))
						};

						console.log('Blue slot clicked with data:', {roomId, startDate, startTime, endTime, recurrenceEndDate, recurrencePattern, roomDetails});

						await openModifyRecurringBookingModal(roomId, startDate, startTime, endTime, recurrenceEndDate, recurrencePattern, roomDetails);
					}
				});

				// Function to open modify recurring booking modal
				async function openModifyRecurringBookingModal(roomId, startDate, startTime, endTime, recurrenceEndDate, recurrencePattern, roomDetails) {
					try {
						// Populate room and date details
						document.getElementById('modifyRecurringModalRoomNameDetail').textContent = roomDetails.Name;
						document.getElementById('modifyRecurringModalRoomCode').textContent = roomDetails.Code;
						document.getElementById('modifyRecurringModalRoomLocation').textContent = roomDetails.Location;
						document.getElementById('modifyRecurringModalRoomCapacity').textContent = roomDetails.Capacity;

						// Format and display dates
						const startDateObj = new Date(startDate + 'T00:00:00');
						const endDateObj = new Date(recurrenceEndDate + 'T00:00:00');
						const formatDate = (date) => date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' });

						document.getElementById('modifyRecurringModalStartDateDisplay').textContent = formatDate(startDateObj);
						document.getElementById('modifyRecurringModalRecurrenceEndDateDisplay').textContent = formatDate(endDateObj);

						// Display recurrence pattern
						const patternDisplay = {
							'None': 'No Recurrence',
							'Daily': 'Daily',
							'Weekly': 'Weekly',
							'BiWeekly': 'Bi-Weekly',
							'FourWeeks': 'Every 4 Weeks'
						};
						const selectedPattern = recurrencePattern || 'None';
						document.getElementById('modifyRecurringModalRecurrencePatternDisplay').textContent = patternDisplay[selectedPattern] || 'Single Booking';

						// Set hidden fields
						document.getElementById('modifyRecurringRoomId').value = roomId;
						document.getElementById('modifyRecurringStartDate').value = startDate;
						document.getElementById('modifyRecurringRecurrenceEndDate').value = recurrenceEndDate;

						// Populate time dropdowns
						populateModifyTimeDropdown('modifyRecurringStartTime', parseInt(startTime.split(':')[0]));
						populateModifyTimeDropdown('modifyRecurringEndTime', parseInt(endTime.split(':')[0]));

						// Fetch booking details and populate status list
						await refreshModifyRecurringBookingStatuses(roomId, startDate, recurrenceEndDate, selectedPattern, startTime, endTime);

						// Clear alerts
						document.getElementById('modifyRecurringBookingAlert').style.display = 'none';

						// Show modal
						const modal = new bootstrap.Modal(document.getElementById('modifyRecurringBookingModal'));
						modal.show();

					} catch (error) {
						console.error('Error opening modal:', error);
						alert('Error: ' + error.message);
					}
				}

				// Helper function to populate time dropdowns
				function populateModifyTimeDropdown(elementId, selectedHour) {
					const select = document.getElementById(elementId);
					select.innerHTML = '';
					for (let hour = 8; hour <= 22; hour++) {
						const option = document.createElement('option');
						const timeStr = `${String(hour).padStart(2, '0')}:00`;
						option.value = timeStr;
						option.textContent = timeStr;
						if (hour === selectedHour) {
							option.selected = true;
						}
						select.appendChild(option);
					}
				}

				// Function to refresh booking statuses when time changes
				async function refreshModifyRecurringBookingStatuses(roomId, startDate, recurrenceEndDate, recurrencePattern, defaultStartTime, defaultEndTime) {
					try {
						console.log('refreshModifyRecurringBookingStatuses called with:', {roomId, startDate, recurrenceEndDate, recurrencePattern, defaultStartTime, defaultEndTime});

						// Get time values from dropdowns with better error handling
						const startTimeSelect = document.getElementById('modifyRecurringStartTime');
						const endTimeSelect = document.getElementById('modifyRecurringEndTime');

						if (!startTimeSelect || !endTimeSelect) {
							console.error('Time select elements not found!');
							throw new Error('Time selection dropdowns not found in DOM');
						}

						const newStartTime = startTimeSelect.value;
						const newEndTime = endTimeSelect.value;

						console.log('Dropdown values retrieved:', {newStartTime, newEndTime, defaultStartTime, defaultEndTime});

						// Ensure we have time values in HH:mm format
						const finalStartTime = (newStartTime && newStartTime.trim().length > 0) ? newStartTime : (defaultStartTime || '08:00');
						const finalEndTime = (newEndTime && newEndTime.trim().length > 0) ? newEndTime : (defaultEndTime || '09:00');

						console.log('Final times to send:', {finalStartTime, finalEndTime});

						const params = new URLSearchParams();
						params.append('roomId', roomId);
						params.append('startDate', startDate);
						params.append('recurrenceEndDate', recurrenceEndDate);
						params.append('recurrencePattern', recurrencePattern);
						params.append('newStartTime', finalStartTime);
						params.append('newEndTime', finalEndTime);

						// Add antiforgery token
						const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
						if (token) {
							params.append('__RequestVerificationToken', token);
						}

						console.log('POST params:', params.toString());

						const response = await fetch('?handler=GetRecurringBookingDetails', {
							method: 'POST',
							headers: {
								'Content-Type': 'application/x-www-form-urlencoded',
								'X-Requested-With': 'XMLHttpRequest'
							},
							body: params.toString()
						});

						console.log('Response status:', response.status, response.ok);

						if (!response.ok) {
							const errorText = await response.text();
							console.error('Error response:', errorText);
							throw new Error(errorText || 'Failed to fetch booking details');
						}

						const data = await response.json();
						console.log('Response data:', data);

						if (!data.success) {
							throw new Error(data.error || 'Failed to fetch booking details');
						}

							// Store booking ID for later use
							document.getElementById('modifyRecurringBookingId').value = data.booking.id;
							console.log('Booking ID set to:', data.booking.id);

							// Populate dates list with status
							const datesList = document.getElementById('modifyRecurringDatesList');
							datesList.innerHTML = '';

							console.log('DateStatuses count:', data.dateStatuses.length);
							console.log('DateStatuses:', data.dateStatuses);

							// Track dates with actual bookings (excluding 'not exist' dates)
							const datesWithBookings = [];

							data.dateStatuses.forEach(dateStatus => {
								let statusBadgeClass = 'bg-success'; // default
								let statusText = 'Existing';

								if (dateStatus.status === 'missing') {
									statusBadgeClass = 'bg-secondary';
									statusText = 'Missing';
								} else if (dateStatus.status === 'missing hour') {
									statusBadgeClass = 'bg-warning';
									statusText = 'Missing Hour';
								}

								// Only include dates that have bookings (status is not 'not exist')
								if (dateStatus.status !== 'not exist') {
									datesWithBookings.push(dateStatus.date);
								}

								const dateItem = document.createElement('div');
								dateItem.className = 'mb-2 p-2 border-bottom';

								// Format time display - only show time if not "not exist"
								const timeHtml = dateStatus.status === 'not exist' 
									? '' 
									: `<span style="margin-left: 10px;">${dateStatus.timeDisplay}</span>`;

									dateItem.innerHTML = `
										<div class="d-flex justify-content-between align-items-center">
											<div>
												<strong>${dateStatus.dateDisplay}</strong>
												${timeHtml}
											</div>
											<span class="badge ${statusBadgeClass}">${statusText}</span>
										</div>
									`;
									datesList.appendChild(dateItem);
								});

								// Store only dates with bookings for delete functionality
								document.getElementById('modifyRecurringRecurrenceDatesJson').value = JSON.stringify(datesWithBookings);
								console.log('Stored dates with bookings count:', datesWithBookings.length, 'Dates:', datesWithBookings);

								console.log('Populated dates list with', datesList.children.length, 'items');

						} catch (error) {
							console.error('Error refreshing statuses:', error);
						document.getElementById('modifyRecurringBookingAlert').style.display = 'block';
						document.getElementById('modifyRecurringBookingErrors').innerHTML = error.message;
					}
				}

				// Handle time change to refresh statuses
				document.addEventListener('DOMContentLoaded', function() {
					const startTimeSelect = document.getElementById('modifyRecurringStartTime');
					const endTimeSelect = document.getElementById('modifyRecurringEndTime');

					startTimeSelect?.addEventListener('change', async function() {
						const roomId = document.getElementById('modifyRecurringRoomId').value;
						const startDate = document.getElementById('modifyRecurringStartDate').value;
						const endDate = document.getElementById('modifyRecurringRecurrenceEndDate').value;
						const patternDisplay = document.getElementById('modifyRecurringModalRecurrencePatternDisplay').textContent;
						const patternMap = {
							'No Recurrence': 'None',
							'Daily': 'Daily',
							'Weekly': 'Weekly',
							'Bi-Weekly': 'BiWeekly',
							'Every 4 Weeks': 'FourWeeks'
						};
						const pattern = patternMap[patternDisplay] || 'None';

						if (roomId) {
							await refreshModifyRecurringBookingStatuses(roomId, startDate, endDate, pattern, '', '');
						}
					});

					endTimeSelect?.addEventListener('change', async function() {
						const roomId = document.getElementById('modifyRecurringRoomId').value;
						const startDate = document.getElementById('modifyRecurringStartDate').value;
						const endDate = document.getElementById('modifyRecurringRecurrenceEndDate').value;
						const patternDisplay = document.getElementById('modifyRecurringModalRecurrencePatternDisplay').textContent;
						const patternMap = {
							'No Recurrence': 'None',
							'Daily': 'Daily',
							'Weekly': 'Weekly',
							'Bi-Weekly': 'BiWeekly',
							'Every 4 Weeks': 'FourWeeks'
						};
						const pattern = patternMap[patternDisplay] || 'None';

						if (roomId) {
							await refreshModifyRecurringBookingStatuses(roomId, startDate, endDate, pattern, '', '');
						}
					});

					// Handle Sync All Bookings button
					document.getElementById('modifyRecurringSyncAllBtn')?.addEventListener('click', async function(e) {
						e.preventDefault();
						const roomId = document.getElementById('modifyRecurringRoomId').value;
						const startDate = document.getElementById('modifyRecurringStartDate').value;
						const recurrenceEndDate = document.getElementById('modifyRecurringRecurrenceEndDate').value;
						const startTime = document.getElementById('modifyRecurringStartTime').value;
						const endTime = document.getElementById('modifyRecurringEndTime').value;

						// Get recurrence pattern from modal
						const patternDisplay = document.getElementById('modifyRecurringModalRecurrencePatternDisplay').textContent;
						const patternMap = {
							'No Recurrence': 'None',
							'Daily': 'Daily',
							'Weekly': 'Weekly',
							'Bi-Weekly': 'BiWeekly',
							'Every 4 Weeks': 'FourWeeks'
						};
						const recurrencePattern = patternMap[patternDisplay] || 'None';

						if (!roomId || !startDate || !recurrenceEndDate) {
							alert('Required parameters not found.');
							return;
						}

						const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
						const params = new URLSearchParams();
						params.append('roomId', roomId);
						params.append('startDate', startDate);
						params.append('recurrenceEndDate', recurrenceEndDate);
						params.append('recurrencePattern', recurrencePattern);
						params.append('newStartTime', startTime);
						params.append('newEndTime', endTime);
						params.append('__RequestVerificationToken', token);

						try {
							const response = await fetch('?handler=BookMissingBookings', {
								method: 'POST',
								headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
								body: params.toString()
							});

							const data = await response.json();

							if (data.success || data.results) {
								// Show results summary
								const stats = data.stats;
								let message = `Booking Missing Slots Completed:\n✓ Created: ${stats.created}\n✗ Failed: ${stats.failed}\n⊙ Skipped: ${stats.skipped}\n\n${data.message}`;
								alert(message);

								// Close modal and reload
								bootstrap.Modal.getInstance(document.getElementById('modifyRecurringBookingModal')).hide();
								setTimeout(() => location.reload(), 500);
							} else {
								document.getElementById('modifyRecurringBookingAlert').style.display = 'block';
								document.getElementById('modifyRecurringBookingErrors').innerHTML = data.error || 'Failed to book missing bookings';
							}
								} catch (error) {
									console.error('Error:', error);
									document.getElementById('modifyRecurringBookingAlert').style.display = 'block';
									document.getElementById('modifyRecurringBookingErrors').innerHTML = error.message;
								}
							});
						});

						// Handle Delete All Bookings button - moved outside the document click handler to prevent multiple listener attachment
						document.addEventListener('DOMContentLoaded', function() {
							document.getElementById('modifyRecurringDeleteAllBtn')?.addEventListener('click', async function(e) {
								e.preventDefault();
								const bookingId = document.getElementById('modifyRecurringBookingId').value;
								const recurrenceDatesJson = document.getElementById('modifyRecurringRecurrenceDatesJson').value;
								const startTime = document.getElementById('modifyRecurringStartTime').value;
								const endTime = document.getElementById('modifyRecurringEndTime').value;

								if (!bookingId) {
									alert('Booking ID not found.');
									return;
								}

								if (!confirm('Are you sure you want to delete all bookings in this recurring series? Bookings that partially overlap will be modified instead. This cannot be undone.')) {
									return;
								}

								const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
								const params = new URLSearchParams();
								params.append('bookingId', bookingId);
								if (recurrenceDatesJson) {
									params.append('recurrenceDatesJson', recurrenceDatesJson);
								}
								if (startTime) {
									params.append('startTime', startTime);
								}
								if (endTime) {
									params.append('endTime', endTime);
								}
								params.append('__RequestVerificationToken', token);

								try {
									const response = await fetch('?handler=DeleteAllBookings', {
										method: 'POST',
										headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
										body: params.toString()
									});

									const data = await response.json();

									if (data.success) {
										const message = `Successfully processed: ${data.deletedCount} deletion(s), ${data.modifiedCount || 0} modification(s).`;
										alert(message);

										// Close modal and reload
										bootstrap.Modal.getInstance(document.getElementById('modifyRecurringBookingModal')).hide();
										setTimeout(() => location.reload(), 500);
									} else {
										document.getElementById('modifyRecurringBookingAlert').style.display = 'block';
										document.getElementById('modifyRecurringBookingErrors').innerHTML = data.error || 'Failed to delete bookings';
									}
								} catch (error) {
									console.error('Error:', error);
									document.getElementById('modifyRecurringBookingAlert').style.display = 'block';
									document.getElementById('modifyRecurringBookingErrors').innerHTML = error.message;
								}
							});
						});

</script>

<!-- Recurring Booking Modal -->
<div class="modal fade" id="recurringBookingModal" tabindex="-1" aria-labelledby="recurringBookingModalLabel" aria-hidden="true">
	<div class="modal-dialog booking-modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="recurringBookingModalLabel">Create Recurring Booking</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>

			<div class="modal-body">
				<!-- Error -->
				<div id="recurringBookingAlert" class="alert alert-danger alert-dismissible fade show" role="alert" style="display: none;">
					<strong>Booking Error!</strong>
					<div id="recurringBookingErrors"></div>
					<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
				</div>

				<form id="recurringBookingForm">
					@Html.AntiForgeryToken()

					<div class="row">
						<!-- Left column: Room Details -->
						<div class="col-4">
							<div class="mb-0">
								<div style="font-size: 1rem; font-weight: 600;">
									<span id="recurringModalRoomNameDetail"></span>
								</div>
								<small class="text-muted room-details" style="font-size: 1rem;">
									<div id="recurringModalRoomCode"></div>
									<div id="recurringModalRoomLocation"></div>
									<div>Capacity: <span id="recurringModalRoomCapacity"></span></div>
								</small>
							</div>
						</div>

						<!-- Vertical divider -->
						<div class="col-1 d-flex justify-content-center">
							<div style="border-left: 1px solid #dee2e6; height: 100%;"></div>
						</div>

						<!-- Right column: Booking Details -->
						<div class="col-7">
							<div class="mb-0" style="white-space: nowrap;">
								<label class="form-label" style="font-size: 0.9rem; font-weight: 600;">Start Date:&nbsp;</label><span id="recurringModalStartDateDisplay"></span>
							</div>
							<div class="mb-0" style="white-space: nowrap;">
								<label class="form-label" style="font-size: 0.9rem; font-weight: 600;">End Date:&nbsp;</label><span id="recurringModalRecurrenceEndDateDisplay"></span>
							</div>
							<div class="mb-0" style="white-space: nowrap;">
								<label class="form-label" style="font-size: 0.9rem; font-weight: 600;">Recurrence Pattern:&nbsp;</label><span id="recurringModalRecurrencePatternDisplay"></span>
							</div>
							<div class="mb-0 d-flex align-items-center gap-2" style="white-space: nowrap;">
								<label for="recurringModalStartTime" class="form-label mb-0 time-label" style="font-size: 0.9rem; font-weight: 600; width: 75px;">Start Hour:&nbsp;</label>
								<select id="recurringModalStartTime" name="startTime" class="form-select form-select-sm" style="width: 80px;" required></select>
							</div>
							<div class="mb-0 d-flex align-items-center gap-2" style="white-space: nowrap;">
								<label for="recurringModalEndTime" class="form-label mb-0 time-label" style="font-size: 0.9rem; font-weight: 600; width: 75px;">End Hour:&nbsp;</label>
								<select id="recurringModalEndTime" name="endTime" class="form-select form-select-sm" style="width: 80px;" required></select>
								<div id="recurringModalTimeValidationError" class="time-validation-error"></div>
							</div>
						</div>
					</div>

					<!-- Notes -->
					<div class="mb-0 mt-2">
						<label for="recurringModalNotes" class="form-label" style="font-size: 0.9rem; font-weight: 600;">Notes (Optional)</label>
						<textarea id="recurringModalNotes" name="notes" class="form-control" rows="2"></textarea>
					</div>

					<!-- Hidden fields -->
					<input type="hidden" id="recurringModalRoomId">
					<input type="hidden" id="recurringModalStartDate">
					<input type="hidden" id="recurringModalRecurrenceEndDate">
					<input type="hidden" id="recurringModalRecurrencePattern">
				</form>
			</div>

			<div class="modal-footer justify-content-start">
				<button type="button" class="btn btn-primary" id="submitRecurringBookingBtn">Create Booking</button>
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
			</div>
		</div>
	</div>
</div>

<!-- Modify Recurring Booking Modal -->
<div class="modal fade" id="modifyRecurringBookingModal" tabindex="-1" aria-labelledby="modifyRecurringBookingModalLabel" aria-hidden="true">
	<div class="modal-dialog booking-modal-dialog" style="max-width: 600px;">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="modifyRecurringBookingModalLabel">Modify Recurring Booking</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>

			<div class="modal-body">
				<!-- Error Alert -->
				<div id="modifyRecurringBookingAlert" class="alert alert-danger alert-dismissible fade show" role="alert" style="display: none;">
					<strong>Error!</strong>
					<div id="modifyRecurringBookingErrors"></div>
					<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
				</div>

				<!-- Room Details Section -->
				<div class="row mb-3">
					<div class="col-6">
						<strong style="font-size: 1rem;" id="modifyRecurringModalRoomNameDetail"></strong>
						<small class="text-muted d-block" style="font-size: 0.9rem;">
							<div id="modifyRecurringModalRoomCode"></div>
							<div id="modifyRecurringModalRoomLocation"></div>
							<div>Capacity: <span id="modifyRecurringModalRoomCapacity"></span></div>
						</small>
					</div>
					<div class="col-6">
						<div style="font-size: 0.9rem;">
							<div><strong>Start:</strong> <span id="modifyRecurringModalStartDateDisplay"></span></div>
							<div><strong>End:</strong> <span id="modifyRecurringModalRecurrenceEndDateDisplay"></span></div>
							<div><strong>Pattern:</strong> <span id="modifyRecurringModalRecurrencePatternDisplay"></span></div>
						</div>
					</div>
				</div>

				<hr />

				<!-- Time Selection Section -->
				<div class="mb-3">
					<label class="form-label"><strong>Select New Time</strong></label>
					<div class="d-flex gap-2 align-items-center">
						<label for="modifyRecurringStartTime" class="form-label mb-0" style="width: 80px;">Start Hour:</label>
						<select id="modifyRecurringStartTime" class="form-select form-select-sm" style="width: 100px;"></select>
						<label for="modifyRecurringEndTime" class="form-label mb-0 ms-2" style="width: 70px;">End Hour:</label>
						<select id="modifyRecurringEndTime" class="form-select form-select-sm" style="width: 100px;"></select>
					</div>
					<div id="modifyRecurringTimeValidationError" class="time-validation-error"></div>
				</div>

				<hr />

				<!-- Recurrence Dates Status Section -->
				<div class="mb-3">
					<label class="form-label"><strong>Recurrence Dates Status</strong></label>
					<div id="modifyRecurringDatesList" style="max-height: 200px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 4px; padding: 8px;">
						<!-- Populated by JavaScript -->
					</div>
				</div>

				<!-- Hidden fields -->
				<input type="hidden" id="modifyRecurringBookingId">
				<input type="hidden" id="modifyRecurringRoomId">
				<input type="hidden" id="modifyRecurringStartDate">
				<input type="hidden" id="modifyRecurringRecurrenceEndDate">
				<input type="hidden" id="modifyRecurringRecurrenceDatesJson">
			</div>

			<div class="modal-footer justify-content-start">
				<button type="button" class="btn btn-primary btn-sm" id="modifyRecurringSyncAllBtn">Book Missing Bookings</button>
				<button type="button" class="btn btn-danger btn-sm" id="modifyRecurringDeleteAllBtn">Delete All</button>
				<button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
			</div>
		</div>
	</div>
</div>

