							<div id="modifyRecurringTimeValidationError" class="time-validation-error"></div>
						</div>
					</div>
				</div>

				<hr />

				<!-- Recurrence Dates Status Section -->
				<div class="mb-3">
					<label class="form-label"><strong>Recurrence Dates Status</strong></label>
					<div id="modifyRecurringDatesList" style="max-height: 200px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 4px; padding: 8px;">
						<!-- Populated by JavaScript -->
					</div>
				</div>

				<!-- Hidden fields -->
				<input type="hidden" id="modifyRecurringBookingId">
				<input type="hidden" id="modifyRecurringRoomId">
				<input type="hidden" id="modifyRecurringStartDate">
				<input type="hidden" id="modifyRecurringRecurrenceEndDate">
